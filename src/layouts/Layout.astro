---
/**
 * Root Layout Component with Comprehensive SEO
 *
 * This layout provides the HTML shell for all pages with full SEO implementation:
 * - Dynamic title templating with "Mekan PLC" branding
 * - Meta description with fallback to default
 * - Canonical URL generation for duplicate content prevention
 * - OpenGraph tags for social media sharing
 * - Twitter Card metadata
 * - Organization structured data (JSON-LD) for Google Knowledge Graph
 *
 * Props:
 * - title: Page-specific title (automatically appends "| Mekan PLC" if not present)
 * - description: Page-specific description (falls back to default company description)
 * - image: Custom OG image path (defaults to /logo1.2.png)
 * - canonical: Override canonical URL (auto-generated from current path if not provided)
 * - overlayNav: Whether navbar should overlay hero content (transparent background)
 * - showCta: Whether to show the closing call-to-action band (default true; error pages turn it off)
 */
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
import { LEGAL_NAME, ALTERNATE_NAMES } from '../data/company';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	canonical?: string;
	overlayNav?: boolean;
	showCta?: boolean;
}

const { title, description, image, canonical, overlayNav = false, showCta = true } = Astro.props;

const DEFAULT_TITLE = 'Mekan PLC | Quality Management, Compliance & Training';
const DEFAULT_DESCRIPTION = 'Mekan PLC provides quality management consulting, compliance support, certification readiness, and training services for agribusiness and related sectors in Ethiopia.';

const requestOrigin = Astro.request?.url ? new URL(Astro.request.url).origin : '';
const configuredSiteUrl = import.meta.env.PUBLIC_SITE_URL || import.meta.env.SITE || '';
const rawSiteUrl = configuredSiteUrl || (requestOrigin.includes('localhost') ? 'https://www.mekanplc.com' : requestOrigin);
const siteUrl = rawSiteUrl.replace('https://mekanplc.com', 'https://www.mekanplc.com').replace(/\/$/, '');

const pageTitle = title
	? (title.includes('Mekan PLC') ? title : `${title} | Mekan PLC`)
	: DEFAULT_TITLE;
const pageDescription = description || DEFAULT_DESCRIPTION;

const canonicalUrl = (() => {
	if (!siteUrl) return undefined;
	if (canonical) return new URL(canonical, siteUrl).toString();
	return new URL(Astro.url.pathname, siteUrl).toString();
})();

const ogImage = image || '/og-image.jpg';
const ogImageUrl = siteUrl ? new URL(ogImage, siteUrl).toString() : ogImage;

const organizationLd = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: LEGAL_NAME,
	alternateName: ALTERNATE_NAMES,
	url: siteUrl || undefined,
	logo: ogImageUrl,
	contactPoint: [
		{
			'@type': 'ContactPoint',
			contactType: 'sales',
			email: 'biniam@mekanplc.com',
			telephone: '+251911454671',
			availableLanguage: ['English']
		}
	]
};
---
 
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- Brand fonts (guide §7). -->
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,500..600&display=swap" rel="stylesheet" />
		<link rel="icon" type="image/png" href="/logo1.2.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		{canonicalUrl ? <link rel="canonical" href={canonicalUrl} /> : null}
		<meta name="robots" content="index,follow" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Mekan PLC" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		{canonicalUrl ? <meta property="og:url" content={canonicalUrl} /> : null}
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:secure_url" content={ogImageUrl} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={ogImageUrl} />

		<script type="application/ld+json" set:html={JSON.stringify(organizationLd)} />
		<script is:inline>
			(() => {
				const STORAGE_KEY = 'theme';
				let stored = null;
				try { stored = localStorage.getItem(STORAGE_KEY); } catch {}
				const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				const theme = stored === 'light' || stored === 'dark' ? stored : systemDark ? 'dark' : 'light';
				document.documentElement.classList.toggle('dark', theme === 'dark');

				// Scroll reveal is opt-in: [data-reveal] content only starts hidden when it can be revealed again.
				const canReveal = 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				document.documentElement.classList.toggle('js-reveal', canReveal);
			})();
		</script>
	</head>
	<body>
		<Navbar overlay={overlayNav} />
		<main>
			<slot />
		</main>
		{showCta && <CTASection />}
		<Footer />

		<script is:inline>
			// Scroll reveal (guide §9): fade and short rise, played once when the element enters the viewport.
			// The observer checks live positions, so content that loads or grows later is still revealed.
			(() => {
				if (!document.documentElement.classList.contains('js-reveal')) return;
				const observer = new IntersectionObserver((entries) => {
					for (const entry of entries) {
						if (!entry.isIntersecting) continue;
						entry.target.classList.add('is-revealed');
						observer.unobserve(entry.target);
					}
				}, { rootMargin: '0px 0px -10% 0px' });
				document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
			})();
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
