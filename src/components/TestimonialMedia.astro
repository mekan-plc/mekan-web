---
import type { Testimonial } from '../data/testimonials';

interface Props {
	testimonial: Testimonial;
	size?: 'sm' | 'lg';
	decorative?: boolean;
}

const { testimonial, size = 'sm', decorative = false } = Astro.props;
const { image, name, company } = testimonial;
const initials = name
	.replace(/^(Mr|Mrs|Ms|Dr)\.?\s+/i, '')
	.split(/\s+/)
	.map((part) => part[0])
	.slice(0, 2)
	.join('')
	.toUpperCase();
const alt = decorative ? '' : image?.type === 'logo' ? `${company} logo` : name;
---

<span class:list={['media', `media--${size}`, image ? `media--${image.type}` : 'media--initials']} aria-hidden={decorative ? 'true' : undefined}>
	{image ? <img src={image.src} alt={alt} loading="lazy" decoding="async" /> : initials}
</span>

<style>
	/* Colours come from the role tokens in tokens.css. Logos always sit on white (guide §5). */
	.media {
		display: inline-flex;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		border-radius: 9999px;
		font-weight: 600;
	}

	.media img {
		width: 100%;
		height: 100%;
	}

	.media--sm {
		width: 2.5rem;
		height: 2.5rem;
		font-size: 0.75rem;
	}

	.media--lg {
		width: 4rem;
		height: 4rem;
		font-size: 1.125rem;
		box-shadow: 0 0 0 4px rgb(var(--color-card)), 0 0 0 5px rgb(var(--color-accent) / 0.4);
	}

	@media (min-width: 1024px) {
		.media--lg {
			width: 8rem;
			height: 8rem;
			font-size: 2rem;
		}
	}

	.media--logo {
		background: rgb(var(--color-logo-panel));
	}

	.media--logo img {
		width: 78%;
		height: 78%;
		object-fit: contain;
	}

	.media--photo img {
		object-fit: cover;
		object-position: center 30%;
	}

	.media--initials {
		background: rgb(var(--color-brand-surface));
		color: rgb(var(--color-on-brand));
	}
</style>
