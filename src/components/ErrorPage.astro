---
/**
 * Shell for the 404 and 500 pages: a calm Paper page under the solid navbar, with
 * the status code, a heading, a short message and the actions in the default slot.
 * No closing CTA band: the actions already say where to go next.
 */
import Layout from '../layouts/Layout.astro';

interface Props {
	code: string;
	title: string;
	description: string;
	heading: string;
	message: string;
}

const { code, title, description, heading, message } = Astro.props;
---

<Layout title={title} description={description} showCta={false}>
	<section class="flex min-h-[calc(100svh-4.5rem)] items-center bg-page py-20">
		<div class="container">
			<div class="mx-auto max-w-2xl text-center">
				<p class="font-heading text-[clamp(5rem,4rem+6vw,8rem)] font-semibold leading-none tracking-tight text-brand/15" aria-hidden="true">{code}</p>
				<p class="eyebrow mt-6">Error {code}</p>
				<h1 class="mt-3 text-h1 text-heading">{heading}</h1>
				<p class="lead mx-auto mt-5 max-w-xl">{message}</p>
				<div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row">
					<slot />
				</div>
			</div>
		</div>
	</section>
</Layout>
