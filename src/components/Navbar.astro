---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
	overlay?: boolean;
}

const { overlay = false } = Astro.props;

const links = [
	{ href: '/#home', label: 'Home' },
	{ href: '/#about', label: 'About' },
	{ href: '/#services', label: 'Services' },
	{ href: '/#projects', label: 'Projects' },
	{ href: '/resources', label: 'Resources' },
	{ href: '/#testimonials', label: 'Testimonials' },
	{ href: '/#blog', label: 'Blogs' },
	{ href: '/#contact', label: 'Contact us' }
];

// Tone (guide §14): over a navy hero the header is transparent and on-navy;
// on a plain page it starts on Paper. Once scrolled it becomes the navy band.
const scrolledClasses =
	'data-[scrolled=true]:border-on-brand/10 data-[scrolled=true]:bg-brand-surface/95 data-[scrolled=true]:shadow-soft data-[scrolled=true]:backdrop-blur-md';
---

<header
	id="site-header"
	data-overlay={overlay ? 'true' : 'false'}
	data-scrolled="false"
	class:list={[
		'inset-x-0 top-0 z-50 border-b transition-[background-color,border-color,box-shadow,color] duration-fast ease-out',
		overlay ? 'on-navy fixed border-transparent bg-transparent' : 'sticky border-line bg-page/85 text-ink backdrop-blur-md',
		scrolledClasses
	]}
>
	<div class="container flex items-center justify-between gap-4 py-3">
		<a href="/" class="flex items-center gap-3 rounded-control">
			<!-- Guide §5: the logo always sits on a white panel, never directly on navy. -->
			<span class="flex h-11 items-center rounded-control bg-logo-panel px-1.5 ring-1 ring-line/60">
				<img src="/logo1.2.png" alt="Mekan Consultancy" class="h-8 w-auto object-contain" />
			</span>
			<span class="hidden text-button font-semibold xl:inline">Mekan Consultancy</span>
		</a>

		<nav aria-label="Main" class="hidden items-center gap-0.5 lg:flex">
			{links.map((l) => <a href={l.href} class="nav-link">{l.label}</a>)}
		</nav>

		<div class="flex items-center gap-2">
			<a href="/#contact" class="btn btn-primary hidden h-10 px-4 lg:inline-flex">Get in touch</a>
			<ThemeToggle />
			<button
				type="button"
				id="mobile-nav-toggle"
				class="btn-icon lg:hidden"
				aria-label="Open navigation menu"
				aria-controls="mobile-nav"
				aria-expanded="false"
			>
				<svg id="mobile-nav-icon-open" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<line x1="4" y1="7" x2="20" y2="7" />
					<line x1="4" y1="12" x2="20" y2="12" />
					<line x1="4" y1="17" x2="20" y2="17" />
				</svg>
				<svg id="mobile-nav-icon-close" class="hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<line x1="6" y1="6" x2="18" y2="18" />
					<line x1="18" y1="6" x2="6" y2="18" />
				</svg>
			</button>
		</div>
	</div>

	<!-- The open menu forces the navy band, so the panel inherits the header's background. -->
	<nav id="mobile-nav" aria-label="Main" class="hidden border-t border-on-brand/10 lg:hidden">
		<div class="container flex flex-col gap-1 py-3">
			{links.map((l) => <a href={l.href} class="nav-link py-3 text-body">{l.label}</a>)}
		</div>
	</nav>
</header>

<script is:inline>
	(() => {
		const header = document.getElementById('site-header');
		if (!header) return;

		const isOverlay = header.dataset.overlay === 'true';
		const toggle = document.getElementById('mobile-nav-toggle');
		const mobileNav = document.getElementById('mobile-nav');
		const iconOpen = document.getElementById('mobile-nav-icon-open');
		const iconClose = document.getElementById('mobile-nav-icon-close');
		let menuOpen = false;

		const apply = () => {
			const navy = window.scrollY > 8 || menuOpen;
			header.dataset.scrolled = navy ? 'true' : 'false';
			header.classList.toggle('on-navy', navy || isOverlay);
			if (!isOverlay) header.classList.toggle('text-ink', !navy);
		};

		const setMenuOpen = (open) => {
			menuOpen = open;
			if (toggle && mobileNav) {
				toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
				toggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
				mobileNav.classList.toggle('hidden', !open);
				iconOpen?.classList.toggle('hidden', open);
				iconClose?.classList.toggle('hidden', !open);
			}
			apply();
		};

		apply();
		window.addEventListener('scroll', apply, { passive: true });

		if (toggle && mobileNav) {
			toggle.addEventListener('click', () => setMenuOpen(!menuOpen));

			mobileNav.addEventListener('click', (e) => {
				const target = e.target;
				if (target && target.closest && target.closest('a')) setMenuOpen(false);
			});

			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && menuOpen) {
					setMenuOpen(false);
					toggle.focus();
				}
			});
		}
	})();
</script>
