---
import { partners } from '../data/partners';

// The track holds the list four times and slides by half its width, so the loop is
// seamless on wide screens. Only the first copy is exposed to screen readers and the keyboard.
const copies = [0, 1, 2, 3];
---

<div class="marquee" role="region" aria-label="Partners">
	<ul class="marquee-track">
		{copies.map((copy) =>
			partners.map((partner) => (
				<li class="shrink-0 px-3 md:px-4" aria-hidden={copy > 0 ? 'true' : undefined}>
					<a
						href={partner.url}
						target="_blank"
						rel="noopener noreferrer"
						title={partner.name}
						tabindex={copy > 0 ? -1 : undefined}
						class="flex h-16 w-28 items-center justify-center rounded-control bg-logo-panel p-2 transition-opacity duration-fast ease-out hover:opacity-90 md:h-[4.5rem] md:w-32"
					>
						<img src={partner.logo} alt={copy > 0 ? '' : partner.name} class="max-h-full max-w-full object-contain" loading="lazy" decoding="async" />
					</a>
				</li>
			))
		)}
	</ul>
</div>
