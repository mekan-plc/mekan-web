---
import type { Testimonial } from '../data/testimonials';
import TestimonialMedia from './TestimonialMedia.astro';

interface Props {
	items: Testimonial[];
	id?: string;
	eyebrow?: string;
	title?: string;
	subtitle?: string;
}

const {
	items,
	id = 'testimonials',
	eyebrow = 'Testimonials',
	title = 'What Our Clients Say',
	subtitle = 'Trusted by producers, exporters and international buyers from Ethiopia to the UK.'
} = Astro.props;

const pad = (n: number) => String(n).padStart(2, '0');
// Give readers enough time: ~240ms per word, clamped between 8s and 45s.
const readingTime = (t: Testimonial) => {
	const words = `${t.highlight ?? ''} ${t.quote}`.trim().split(/\s+/).length;
	return Math.min(45000, Math.max(8000, words * 240));
};
const multiple = items.length > 1;
---

<section id={id} class="testimonials section" data-testimonials aria-roledescription="carousel" aria-label="Client testimonials">
	<div class="glow" aria-hidden="true"></div>

	<div class="container relative">
		<div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
			<div class="max-w-2xl">
				<p class="text-sm font-medium text-[hsl(var(--brand))] uppercase tracking-wide">{eyebrow}</p>
				<h2 class="mt-4 text-3xl font-semibold tracking-tight">{title}</h2>
				<p class="mt-4 text-base text-[hsl(var(--muted-foreground))]">{subtitle}</p>
			</div>

			{multiple && (
				<div class="controls">
					<span class="counter" aria-hidden="true">
						<span data-current>01</span>
						<span class="counter-sep">/</span>
						<span>{pad(items.length)}</span>
					</span>
					<button type="button" class="nav-btn" data-toggle aria-label="Pause autoplay">
						<svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6.5" y="5" width="3.5" height="14" rx="1" /><rect x="14" y="5" width="3.5" height="14" rx="1" /></svg>
						<svg class="icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z" /></svg>
					</button>
					<button type="button" class="nav-btn" data-prev aria-label="Previous testimonial">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
					</button>
					<button type="button" class="nav-btn" data-next aria-label="Next testimonial">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
					</button>
				</div>
			)}
		</div>

		<div class="stage" data-stage>
			<span class="quote-mark" aria-hidden="true">&ldquo;</span>
			<div class="slides" aria-live="polite" data-slides>
				{items.map((t, i) => (
					<figure
						id={`${id}-panel-${i}`}
						role={multiple ? 'tabpanel' : undefined}
						aria-labelledby={multiple ? `${id}-tab-${i}` : undefined}
						aria-hidden={i === 0 ? undefined : 'true'}
						inert={i !== 0}
						class:list={['slide', { 'is-active': i === 0 }]}
						data-slide
						data-duration={readingTime(t)}
					>
						<figcaption class="author">
							<TestimonialMedia testimonial={t} size="lg" />
							<div class="author-text">
								<p class="author-name">{t.name}</p>
								<p class="author-role">{t.role}</p>
								<p class="author-company">{t.company}</p>
								{t.location && (
									<p class="author-location">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
										{t.location}
									</p>
								)}
							</div>
						</figcaption>

						<blockquote class="body">
							{t.highlight && <p class="highlight" aria-hidden="true">{t.highlight}</p>}
							<p class="quote">&ldquo;{t.quote}&rdquo;</p>
						</blockquote>
					</figure>
				))}
			</div>
		</div>

		{multiple && (
			<div class="tabs" role="tablist" aria-label="Choose a testimonial" data-tablist>
				{items.map((t, i) => (
					<button
						type="button"
						role="tab"
						id={`${id}-tab-${i}`}
						aria-controls={`${id}-panel-${i}`}
						aria-selected={i === 0 ? 'true' : 'false'}
						aria-label={`${t.name}, ${t.company}`}
						tabindex={i === 0 ? 0 : -1}
						class:list={['tab', { 'is-active': i === 0 }]}
						data-tab
					>
						<TestimonialMedia testimonial={t} decorative />
						<span class="tab-text">
							<span class="tab-name">{t.name}</span>
							<span class="tab-company">{t.company}</span>
						</span>
						<span class="tab-progress" aria-hidden="true"><span data-progress></span></span>
					</button>
				))}
			</div>
		)}
	</div>
</section>

<script>
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	document.querySelectorAll<HTMLElement>('[data-testimonials]').forEach((root) => {
		const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
		const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
		if (slides.length < 2) return;

		const bars = tabs.map((tab) => tab.querySelector<HTMLElement>('[data-progress]'));
		const tablist = root.querySelector<HTMLElement>('[data-tablist]');
		const counter = root.querySelector<HTMLElement>('[data-current]');
		const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]');
		const stage = root.querySelector<HTMLElement>('[data-stage]');

		let index = 0;
		let elapsed = 0;
		let last = 0;
		let playing = !reduceMotion;
		let hovered = false;
		let focused = false;
		let visible = false;

		const duration = () => Number(slides[index].dataset.duration) || 10000;

		const paint = () => {
			bars.forEach((bar, i) => {
				if (!bar) return;
				const progress = i !== index ? 0 : playing ? Math.min(elapsed / duration(), 1) : 1;
				bar.style.transform = `scaleX(${progress})`;
			});
		};

		const go = (next: number, focusTab = false) => {
			index = (next + slides.length) % slides.length;
			slides.forEach((slide, i) => {
				const active = i === index;
				slide.classList.toggle('is-active', active);
				slide.toggleAttribute('inert', !active);
				if (active) slide.removeAttribute('aria-hidden');
				else slide.setAttribute('aria-hidden', 'true');
			});
			tabs.forEach((tab, i) => {
				const active = i === index;
				tab.classList.toggle('is-active', active);
				tab.setAttribute('aria-selected', String(active));
				tab.tabIndex = active ? 0 : -1;
			});
			const tab = tabs[index];
			if (tablist && tab) {
				tablist.scrollTo({ left: tab.offsetLeft - tablist.offsetLeft - 16, behavior: reduceMotion ? 'auto' : 'smooth' });
			}
			if (focusTab) tab?.focus();
			if (counter) counter.textContent = String(index + 1).padStart(2, '0');
			elapsed = 0;
			paint();
		};

		const setPlaying = (value: boolean) => {
			playing = value;
			root.classList.toggle('is-paused', !playing);
			root.querySelector('[data-slides]')?.setAttribute('aria-live', playing ? 'off' : 'polite');
			toggle?.setAttribute('aria-label', playing ? 'Pause autoplay' : 'Play autoplay');
			paint();
		};

		const tick = (now: number) => {
			const dt = last ? Math.min(now - last, 100) : 0;
			last = now;
			if (playing && visible && !hovered && !focused && !document.hidden) {
				elapsed += dt;
				if (elapsed >= duration()) go(index + 1);
				else paint();
			}
			requestAnimationFrame(tick);
		};

		tabs.forEach((tab, i) => tab.addEventListener('click', () => go(i)));
		root.querySelector('[data-prev]')?.addEventListener('click', () => go(index - 1));
		root.querySelector('[data-next]')?.addEventListener('click', () => go(index + 1));
		toggle?.addEventListener('click', () => setPlaying(!playing));

		tablist?.addEventListener('keydown', (e) => {
			const keys: Record<string, number> = { ArrowRight: index + 1, ArrowLeft: index - 1, Home: 0, End: slides.length - 1 };
			if (!(e.key in keys)) return;
			e.preventDefault();
			go(keys[e.key], true);
		});

		root.addEventListener('mouseenter', () => (hovered = true));
		root.addEventListener('mouseleave', () => (hovered = false));
		root.addEventListener('focusin', (e) => (focused = (e.target as HTMLElement).matches(':focus-visible')));
		root.addEventListener('focusout', (e) => {
			if (!root.contains(e.relatedTarget as Node)) focused = false;
		});

		let startX = 0;
		let startY = 0;
		stage?.addEventListener('touchstart', (e) => {
			startX = e.touches[0].clientX;
			startY = e.touches[0].clientY;
		}, { passive: true });
		stage?.addEventListener('touchend', (e) => {
			const dx = e.changedTouches[0].clientX - startX;
			const dy = e.changedTouches[0].clientY - startY;
			if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) go(index + (dx < 0 ? 1 : -1));
		}, { passive: true });

		new IntersectionObserver(([entry]) => (visible = entry.isIntersecting), { threshold: 0.35 }).observe(root);

		setPlaying(playing);
		requestAnimationFrame(tick);
	});
</script>

<style>
	.testimonials {
		position: relative;
		overflow: hidden;
		background: hsl(var(--background));
		border-top: 1px solid hsl(var(--border));
	}

	.glow {
		position: absolute;
		top: 30%;
		left: 50%;
		width: min(70rem, 120%);
		height: 34rem;
		transform: translateX(-50%);
		background: radial-gradient(closest-side, hsl(var(--accent) / 0.09), transparent);
		pointer-events: none;
	}

	/* Controls */
	.controls {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.counter {
		margin-right: 0.75rem;
		font-size: 0.875rem;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.08em;
		color: hsl(var(--muted-foreground));
	}

	.counter [data-current] {
		color: hsl(var(--foreground));
		font-weight: 600;
	}

	.counter-sep {
		margin: 0 0.35rem;
		opacity: 0.4;
	}

	.nav-btn {
		display: inline-flex;
		width: 2.75rem;
		height: 2.75rem;
		align-items: center;
		justify-content: center;
		border-radius: 9999px;
		border: 1px solid hsl(var(--border));
		background: hsl(var(--card) / 0.6);
		color: hsl(var(--foreground));
		transition: border-color 0.3s, background-color 0.3s, color 0.3s, transform 0.3s;
	}

	.nav-btn:hover {
		border-color: hsl(var(--accent) / 0.6);
		color: hsl(var(--accent));
		transform: translateY(-1px);
	}

	.nav-btn:focus-visible,
	.tab:focus-visible {
		outline: 2px solid hsl(var(--accent));
		outline-offset: 3px;
	}

	.nav-btn svg {
		width: 1.15rem;
		height: 1.15rem;
	}

	.icon-play,
	.is-paused .icon-pause {
		display: none;
	}

	.is-paused .icon-play {
		display: block;
	}

	/* Stage */
	.stage {
		position: relative;
		margin-top: 3rem;
		overflow: hidden;
		border-radius: 1.75rem;
		border: 1px solid hsl(var(--border));
		background: linear-gradient(150deg, hsl(var(--card)) 0%, hsl(var(--card) / 0.75) 55%, hsl(var(--background)) 100%);
		padding: 2rem 1.5rem;
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 30px 60px -30px rgb(0 0 0 / 0.25);
	}

	@media (min-width: 768px) {
		.stage {
			padding: 3rem;
		}
	}

	@media (min-width: 1024px) {
		.stage {
			padding: 3.5rem 4rem;
		}
	}

	.quote-mark {
		position: absolute;
		top: -2.5rem;
		right: 1.5rem;
		font-family: 'Fraunces', Georgia, serif;
		font-size: 14rem;
		line-height: 1;
		color: hsl(var(--accent) / 0.14);
		pointer-events: none;
		user-select: none;
	}

	/* All slides share one grid cell, so the stage always matches the longest quote. */
	.slides {
		position: relative;
		display: grid;
	}

	.slide {
		grid-area: 1 / 1;
		display: grid;
		gap: 2rem;
		margin: 0;
		opacity: 0;
		visibility: hidden;
		transform: translateY(14px);
		transition: opacity 0.5s ease, transform 0.5s ease, visibility 0s linear 0.5s;
	}

	.slide.is-active {
		opacity: 1;
		visibility: visible;
		transform: none;
		transition: opacity 0.7s ease 0.15s, transform 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.15s, visibility 0s;
	}

	@media (min-width: 1024px) {
		.slide {
			grid-template-columns: 15rem 1fr;
			gap: 3.5rem;
			align-items: center;
		}
	}

	/* Author */
	.author {
		order: 2;
		display: flex;
		align-items: center;
		gap: 1rem;
		padding-top: 1.5rem;
		border-top: 1px solid hsl(var(--border));
	}

	@media (min-width: 1024px) {
		.author {
			order: 0;
			align-self: stretch;
			flex-direction: column;
			align-items: flex-start;
			justify-content: center;
			gap: 1.5rem;
			padding: 0 3rem 0 0;
			border-top: 0;
			border-right: 1px solid hsl(var(--border));
		}
	}

	.author-name {
		font-size: 1rem;
		font-weight: 600;
		color: hsl(var(--foreground));
	}

	.author-role {
		margin-top: 0.125rem;
		font-size: 0.875rem;
		color: hsl(var(--accent));
		font-weight: 500;
	}

	.author-company {
		margin-top: 0.125rem;
		font-size: 0.875rem;
		color: hsl(var(--foreground) / 0.8);
	}

	.author-location {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 0.75rem;
		padding: 0.25rem 0.65rem;
		border-radius: 9999px;
		border: 1px solid hsl(var(--border));
		font-size: 0.75rem;
		color: hsl(var(--muted-foreground));
	}

	.author-location svg {
		width: 0.85rem;
		height: 0.85rem;
	}

	@media (min-width: 1024px) {
		.author-name {
			font-size: 1.125rem;
		}
	}

	/* Quote */
	.body {
		margin: 0;
	}

	.highlight {
		font-family: 'Fraunces', Georgia, serif;
		font-style: italic;
		font-weight: 400;
		font-size: clamp(1.375rem, 1.05rem + 1.2vw, 2rem);
		line-height: 1.3;
		letter-spacing: -0.01em;
		color: hsl(var(--foreground));
	}

	.highlight::after {
		content: '';
		display: block;
		width: 3rem;
		height: 2px;
		margin: 1.5rem 0;
		border-radius: 9999px;
		background: hsl(var(--accent));
	}

	.quote {
		max-width: 70ch;
		font-size: 1rem;
		line-height: 1.8;
		color: hsl(var(--foreground) / 0.72);
	}

	@media (min-width: 768px) {
		.quote {
			font-size: 1.0625rem;
		}
	}

	/* Tabs */
	.tabs {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: max-content;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 1.5rem;
		padding: 4px;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
	}

	.tabs::-webkit-scrollbar {
		display: none;
	}

	@media (min-width: 640px) {
		.tabs {
			grid-auto-columns: minmax(15rem, 1fr);
			justify-content: stretch;
		}
	}

	.tab {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.5rem;
		overflow: hidden;
		border-radius: 9999px;
		border: 1px solid hsl(var(--border));
		background: hsl(var(--card) / 0.4);
		text-align: left;
		scroll-snap-align: start;
		opacity: 0.6;
		transition: opacity 0.3s, border-color 0.3s, background-color 0.3s, box-shadow 0.3s;
	}

	@media (min-width: 640px) {
		.tab {
			padding: 0.875rem 1rem 1rem;
			border-radius: 1rem;
		}
	}

	.tab:hover {
		opacity: 1;
		border-color: hsl(var(--accent) / 0.4);
	}

	.tab.is-active {
		opacity: 1;
		background: hsl(var(--card));
		border-color: hsl(var(--accent) / 0.55);
		box-shadow: 0 10px 30px -15px hsl(var(--accent) / 0.45);
	}

	.tab-text {
		display: none;
		min-width: 0;
	}

	@media (min-width: 640px) {
		.tab-text {
			display: block;
		}
	}

	.tab-name,
	.tab-company {
		display: block;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
	}

	.tab-name {
		font-size: 0.875rem;
		font-weight: 500;
		color: hsl(var(--foreground));
	}

	.tab-company {
		font-size: 0.75rem;
		color: hsl(var(--muted-foreground));
	}

	.tab-progress {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 3px;
		display: none;
		background: hsl(var(--border) / 0.6);
	}

	@media (min-width: 640px) {
		.tab-progress {
			display: block;
		}
	}

	.tab-progress > span {
		display: block;
		height: 100%;
		background: hsl(var(--accent));
		transform: scaleX(0);
		transform-origin: left;
	}

	@media (prefers-reduced-motion: reduce) {
		.slide,
		.slide.is-active {
			transform: none;
			transition: opacity 0.2s, visibility 0s;
		}
	}
</style>
