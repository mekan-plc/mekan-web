---
/**
 * Blog card: photo (or document icon on the green tint) with the category badge,
 * then date, title, a clamped excerpt and "Read more".
 *
 * Pages that load posts in the browser render one copy inside a <template> and
 * fill it with fillBlogCard() from src/scripts/blog-card.ts; the data-field
 * hooks mark what the script fills.
 */
interface Props {
	href: string;
	title: string;
	date?: string;
	excerpt?: string;
	category?: string;
	imageUrl?: string | null;
	class?: string;
}

const { href, title, date, excerpt, category, imageUrl, class: className } = Astro.props;
---

<a
	href={href}
	class:list={['card card-interactive group flex flex-col overflow-hidden', className]}
	data-field="link"
>
	<div class="relative aspect-[16/10] overflow-hidden border-b border-line bg-tint-accent" data-field="media">
		{imageUrl ? (
			<img src={imageUrl} alt={title} class="absolute inset-0 h-full w-full object-cover" loading="lazy" decoding="async" />
		) : (
			<div class="flex h-full items-center justify-center text-accent/40" aria-hidden="true" data-field="placeholder">
				<svg class="h-10 w-10" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
					<path d="M6.5 3.5h7l4 4v12a1 1 0 0 1-1 1h-10a1 1 0 0 1-1-1v-15a1 1 0 0 1 1-1Z" />
					<path d="M13.5 3.5v4h4M8.5 12h7M8.5 15.5h7" />
				</svg>
			</div>
		)}
		{category && <span class="badge absolute left-4 top-4" data-field="category">{category}</span>}
	</div>

	<div class="flex flex-grow flex-col p-6 md:p-7">
		<p class="text-small text-muted" data-field="date">{date}</p>
		<h3 class="mt-2 text-h3 text-heading transition-colors duration-fast ease-out group-hover:text-brand" data-field="title">
			{title}
		</h3>
		<p class="mt-3 line-clamp-3 flex-grow text-small text-muted" data-field="excerpt">
			{excerpt}
		</p>
		<span class="mt-6 inline-flex items-center gap-2 text-button font-semibold text-accent underline-offset-4 group-hover:underline">
			Read more
			<svg class="h-4 w-4 transition-transform duration-fast ease-out group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M17 8l4 4m0 0l-4 4m4-4H3" />
			</svg>
		</span>
	</div>
</a>
