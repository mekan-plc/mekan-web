---
/**
 * Inner-page hero: the navy brand band with faint frame-grid lines (guide §8, §14),
 * a breadcrumb trail and the page title. Sits under the overlay navbar.
 * Extra content (meta, badges, a lead paragraph) goes in the default slot.
 */
interface Crumb {
	label: string;
	href?: string;
}

interface Props {
	title: string;
	breadcrumbs?: Crumb[];
	eyebrow?: string;
	lead?: string;
	align?: 'left' | 'center';
}

const { title, breadcrumbs = [], eyebrow, lead, align = 'left' } = Astro.props;
const trail: Crumb[] = [{ label: 'Home', href: '/' }, ...breadcrumbs];
const centered = align === 'center';
---

<section class="brand-band relative overflow-hidden">
	<div class="frame-grid" aria-hidden="true"></div>

	<div class="container relative pb-16 pt-28 md:pb-20 md:pt-36">
		<!-- The breadcrumb always sits top-left, in the same place on every page; align only moves the title block. -->
		<nav aria-label="Breadcrumb" class="mb-8">
			<ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-small">
				{trail.map((crumb, i) => (
					<li class="flex items-center gap-2">
						{i > 0 && (
							<svg class="h-3.5 w-3.5 text-on-brand/40" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 5l7 7-7 7" />
							</svg>
						)}
						{crumb.href && i < trail.length - 1 ? (
							<a href={crumb.href} class="link-quiet">{crumb.label}</a>
						) : (
							<span class="font-medium text-on-brand" aria-current="page">{crumb.label}</span>
						)}
					</li>
				))}
			</ol>
		</nav>

		<div class:list={['max-w-3xl', centered && 'mx-auto text-center']}>
			{eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
			<h1 class="text-h1">{title}</h1>
			{lead && <p class="lead mt-5">{lead}</p>}
			<slot />
		</div>
	</div>
</section>
