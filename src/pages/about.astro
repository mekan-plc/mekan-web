---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';

const values = [
	{
		title: 'Excellence',
		description: 'We consistently operate at the highest standards, delivering rigorous technical solutions and cultivating strong, trust-based client relationships.'
	},
	{
		title: 'Integrity',
		description: 'Honest, transparent, and principled guidance that consistently prioritizes the client’s long-term success over short-term gains.'
	},
	{
		title: 'Innovation',
		description: 'Continuously advancing and refining our approaches to address emerging challenges and opportunities in global agribusiness.'
	},
	{
		title: 'Impact',
		description: 'Quantifiable, evidence-based outcomes that deliver sustained, long-term positive change for clients and the communities they serve.'
	},
	{
		title: 'Partnership',
		description: 'Collaborating with clients as strategic, long-term partners, fully aligned in goals, accountability, and shared success—beyond the role of a conventional service provider.'
	},
	{
		title: 'Sustainability',
		description: 'Advancing integrated practices that safeguard environmental integrity while maintaining long-term economic viability and resilience.'
	}
];

const stats = [
	{ number: '8+', label: 'Years of Experience (Established 2018 GC)' },
	{ number: '50+', label: 'Clients Served' },
	{ number: '50+', label: 'Projects & Certifications Supported' },
	{ number: '20+', label: 'Freelance Consultants & Trainers' }
];

const team = [
	{
		name: 'Biniam Amberbir',
		role: 'Chief Executive Officer',
		bio: 'Leads Mekan’s quality, compliance, and strategic advisory work across agribusiness and supply chains.',
		image: '/team/Biniam%20Amberbir.jpg'
	},
	{
		name: 'Meron Melaku',
		role: 'Technical Director',
		bio: 'Leads technical programs for standards implementation, food safety systems, and capacity building.',
		image: '/team/Meron%20Melaku.jpg'
	},
	{
		name: 'Omarsherif Mohamed, PhD',
		role: 'Training Director',
		bio: 'Oversees training programs and professional development for agribusiness compliance and performance.',
		image: '/team/Omarsherif%20mohammed.jpg'
	},
	{
		name: 'Girma Asmamaw, PhD',
		role: 'Senior Consultant & Trainer',
		bio: 'Supports clients with practical implementation of standards, training, and continuous improvement programs.',
		image: '/team/Girma%20Asmamaw.jpg'
	},
	{
		name: 'Moges Mekonen, PhD',
		role: 'Senior Consultant & Trainer',
		bio: 'Provides advisory and training support across food safety systems, farm management, and audit readiness.',
		image: '/team/Moges%20Mekonen.jpg'
	}
];

// Mission and vision, each with a line icon (24px grid, 1.75px stroke).
const statements = [
	{
		title: 'Our Mission',
		text: 'To empower agribusinesses and supply chain actors through practical, high-impact consulting and training that strengthen quality assurance, ensure regulatory compliance, and drive sustainable growth.',
		icon: ['M13 10V3L4 14h7v7l9-11h-7z']
	},
	{
		title: 'Our Vision',
		text: 'To build a resilient, competitive agribusiness sector grounded in international standards, responsible practices, and strong value chains that deliver sustainable prosperity.',
		icon: ['M15 12a3 3 0 11-6 0 3 3 0 016 0z', 'M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z']
	}
];
---


<Layout title="About" description="Learn about Mekan PLC — a consultancy delivering quality management, compliance support, certification readiness, and training services for agribusiness in Ethiopia." overlayNav>
	<PageHero title="Who we are" breadcrumbs={[{ label: 'Who we are' }]} align="center" />

	<section class="section bg-page">
		<div class="container">
			<div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
				<div class="lg:col-span-7">
					<h2 class="section-title">Our Story</h2>
					<div class="mt-6 max-w-prose space-y-4 text-copy">
						<p>
							Mekan Quality Management &amp; Training PLC was established in 2018 GC by two visionary experts with extensive experience in the fruit and vegetable production sector. Their mission was to address key bottlenecks in Ethiopia’s agribusiness landscape and elevate food production to meet international standards, positioning Mekan among the pioneering firms bridging local producers with premium global markets.
						</p>
						<p>
							From a two-person consultancy, Mekan has grown into a team of over ten highly qualified consultants and researchers, supported by dedicated staff. The firm combines strong expertise in food safety systems, certification standards, and sustainable agriculture with a deep understanding of local challenges—enabling solutions that are both globally credible and locally practical.
						</p>
						<p>
							As a trusted technical partner, Mekan supports agribusinesses in navigating complex requirements, including EU market access, Global G.A.P. certification, and ESG frameworks. By integrating agronomic expertise with data-driven strategy, the firm helps optimize value chains and strengthen competitiveness.
						</p>
						<p>
							Today, Mekan stands at the forefront of Ethiopia’s agricultural transformation, enabling businesses to access premium markets, improve productivity, and build resilience in a changing climate and economic environment.
						</p>
					</div>
				</div>

				<div class="card corner-marks p-8 lg:col-span-5">
					<h3 class="text-h3 text-heading">By the Numbers</h3>
					<dl class="mt-6 grid grid-cols-2 gap-x-6 gap-y-8">
						{stats.map((stat) => (
							<div class="flex flex-col gap-2 border-t border-line pt-5">
								<dt class="order-2 text-small text-muted">{stat.label}</dt>
								<dd class="order-1 font-heading text-stat font-semibold text-brand">{stat.number}</dd>
							</div>
						))}
					</dl>
				</div>
			</div>
		</div>
	</section>

	{/* Mission and vision: tint callouts (guide §6) with navy icon tiles */}
	<section class="section border-t border-line bg-page">
		<div class="container">
			<div class="grid gap-6 md:grid-cols-2">
				{statements.map((item) => (
					<div class="rounded-card bg-tint-brand p-8 md:p-10">
						<span class="mb-6 flex h-12 w-12 items-center justify-center rounded-control bg-brand-surface text-on-brand" aria-hidden="true">
							<svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
								{item.icon.map((d) => <path d={d} />)}
							</svg>
						</span>
						<h3 class="text-h3 text-heading">{item.title}</h3>
						<p class="mt-4 text-copy">{item.text}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="section border-t border-line bg-page">
		<div class="container">
			<div class="mx-auto mb-12 max-w-2xl text-center">
				<h2 class="section-title">Our Values</h2>
				<p class="lead mt-4">
					The principles that guide every decision we make and every relationship we build.
				</p>
			</div>
			<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				{values.map((value) => (
					<div class="card p-7">
						<span class="mb-5 block h-0.5 w-8 bg-accent" aria-hidden="true"></span>
						<h3 class="text-h3 text-heading">{value.title}</h3>
						<p class="mt-3 text-small text-muted">{value.description}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="section border-t border-line bg-page">
		<div class="container">
			<div class="mx-auto mb-12 max-w-2xl text-center">
				<h2 class="section-title">Leadership Team</h2>
				<p class="lead mt-4">
					Experienced professionals dedicated to transforming Ethiopian agribusiness.
				</p>
			</div>
			<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-6">
				{team.map((member, index) => (
					<article
						class:list={[
							'card overflow-hidden lg:col-span-2',
							team.length % 3 === 2 && index === team.length - 2 && 'lg:col-start-2',
							team.length % 3 === 2 && index === team.length - 1 && 'lg:col-start-4'
						]}
					>
						<div class="aspect-[4/3] w-full overflow-hidden border-b border-line bg-tint-brand">
							{member.image ? (
								<img src={member.image} alt={member.name} class="h-full w-full object-cover object-center" loading="lazy" decoding="async" />
							) : (
								<div class="flex h-full w-full items-center justify-center text-brand/40" aria-hidden="true">
									<svg class="h-14 w-14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
									</svg>
								</div>
							)}
						</div>
						<div class="p-6">
							<h3 class="text-h3 text-heading">{member.name}</h3>
							<p class="mt-1 text-small font-medium text-accent">{member.role}</p>
							<p class="mt-3 text-small text-muted">{member.bio}</p>
						</div>
					</article>
				))}
			</div>
			<p class="mt-10 text-center text-small text-muted">
				Plus <span class="font-semibold text-brand">20+ freelance consultants</span> supporting specialized assignments.
			</p>
		</div>
	</section>

</Layout>
