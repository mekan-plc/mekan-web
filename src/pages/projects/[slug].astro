---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { getProjectBySlug } from '../../lib/wp';

export const prerender = false;

const { slug } = Astro.params;
const project = await getProjectBySlug(slug);

if (!project) {
	return Astro.redirect('/projects');
}

const requestOrigin = Astro.request?.url ? new URL(Astro.request.url).origin : '';
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || requestOrigin).replace(/\/$/, '');
const pageUrl = siteUrl ? new URL(Astro.url.pathname, siteUrl).toString() : Astro.url.pathname;
const imageUrl = project.imageUrl || (siteUrl ? new URL('/logo1.2.png', siteUrl).toString() : '/logo1.2.png');

const projectLd = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: project.title,
	description: project.description,
	image: imageUrl,
	url: pageUrl,
	provider: {
		'@type': 'Organization',
		name: 'Mekan PLC',
		url: siteUrl || undefined,
		logo: siteUrl ? new URL('/logo1.2.png', siteUrl).toString() : '/logo1.2.png',
		contactPoint: {
			'@type': 'ContactPoint',
			contactType: 'sales',
			email: 'biniam@mekanplc.com',
			telephone: '+251911454671',
			availableLanguage: ['English']
		}
	},
	areaServed: {
		'@type': 'Place',
		name: project.location || 'Ethiopia'
	}
};

// Line icons (24px grid, 1.75px stroke, guide §9).
const icons = {
	location: ['M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z', 'M15 11a3 3 0 11-6 0 3 3 0 016 0z'],
	duration: ['M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z'],
	check: ['M5 13l4 4L19 7']
};

const meta = [
	{ label: 'Location', value: project.location, icon: icons.location },
	{ label: 'Duration', value: project.duration, icon: icons.duration }
].filter((item) => item.value);
---

<Layout title={project.title} description={(project.description || '').slice(0, 160)} overlayNav>
	<script type="application/ld+json" set:html={JSON.stringify(projectLd)} />
	<PageHero
		title={project.title}
		eyebrow={project.client}
		breadcrumbs={[{ label: 'Projects', href: '/projects' }, { label: project.title }]}
	>
		{meta.length > 0 && (
			<ul class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-small text-on-brand/80">
				{meta.map((item) => (
					<li class="flex items-center gap-2">
						<svg class="h-4 w-4 text-on-brand-accent" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
							{item.icon.map((d) => <path d={d} />)}
						</svg>
						<span class="sr-only">{item.label}:</span>
						{item.value}
					</li>
				))}
			</ul>
		)}
	</PageHero>

	<section class="section bg-page">
		<div class="container">
			<div class="mx-auto max-w-5xl">
				{project.imageUrl && (
					<div class="mb-12 aspect-video overflow-hidden rounded-card border border-line bg-tint-brand">
						<img src={project.imageUrl} alt={project.title} class="h-full w-full object-cover" loading="eager" decoding="async" />
					</div>
				)}

				<div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-12">
					<div>
						{project.description && (
							<div class="rounded-card bg-tint-brand p-6 md:p-8">
								<p class="eyebrow">Project Overview</p>
								<p class="mt-3 text-lead text-ink">{project.description}</p>
							</div>
						)}

						{project.content && (
							<article class="prose prose-lg mt-10 max-w-none prose-img:border prose-img:border-line">
								<div set:html={project.content}></div>
							</article>
						)}

						<a href="/projects" class="link mt-12 inline-flex items-center gap-2">
							<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
							</svg>
							Back to all projects
						</a>
					</div>

					{/* Details and contact: beside the story on desktop, below it on phones */}
					<aside class="space-y-6 lg:sticky lg:top-28 lg:self-start">
						<div class="card p-6">
							<h2 class="text-h3 text-heading">Project Details</h2>

							{meta.length > 0 && (
								<dl class="mt-5 space-y-4">
									{meta.map((item) => (
										<div class="flex items-start gap-3">
											<svg class="mt-0.5 h-5 w-5 shrink-0 text-brand" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
												{item.icon.map((d) => <path d={d} />)}
											</svg>
											<div>
												<dt class="text-small text-muted">{item.label}</dt>
												<dd class="text-small font-medium text-ink">{item.value}</dd>
											</div>
										</div>
									))}
								</dl>
							)}

							{project.services && project.services.length > 0 && (
								<div class="mt-6 border-t border-line pt-5">
									<h3 class="font-body text-small font-medium text-muted">Services</h3>
									<ul class="mt-3 flex flex-wrap gap-2">
										{project.services.map((service) => (
											<li class="badge badge-brand">{service}</li>
										))}
									</ul>
								</div>
							)}

							{project.results && project.results.length > 0 && (
								<div class="mt-6 border-t border-line pt-5">
									<h3 class="font-body text-small font-medium text-muted">Key Results</h3>
									<ul class="mt-3 space-y-2.5">
										{project.results.map((result) => (
											<li class="flex items-start gap-2.5 text-small text-ink">
												<svg class="mt-0.5 h-4 w-4 shrink-0 text-accent" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
													{icons.check.map((d) => <path d={d} />)}
												</svg>
												<span>{result}</span>
											</li>
										))}
									</ul>
								</div>
							)}
						</div>

						{/* No frame grid here: the hero already has one (guide §8, one frame treatment per view) */}
						<div class="brand-band rounded-card p-6">
							<h2 class="text-h3">Need Expert Help?</h2>
							<p class="mt-2 text-small text-on-brand/80">Our consultants can help you implement these strategies in your business.</p>
							<a href="/#contact" class="btn btn-primary mt-5">
								Contact Us
								<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M17 8l4 4m0 0l-4 4m4-4H3" />
								</svg>
							</a>
						</div>
					</aside>
				</div>
			</div>
		</div>
	</section>
</Layout>
