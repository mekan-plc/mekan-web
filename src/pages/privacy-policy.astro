---
import LegalPage from '../components/LegalPage.astro';
import LegalSection from '../components/LegalSection.astro';

const sections = [
	{ id: 'introduction', num: '1', title: 'Introduction' },
	{ id: 'information', num: '2', title: 'Information We Collect' },
	{ id: 'usage', num: '3', title: 'How We Use Your Information' },
	{ id: 'security', num: '4', title: 'Data Security' },
	{ id: 'rights', num: '5', title: 'Your Rights' },
	{ id: 'contact', num: '6', title: 'Contact Us' },
];
---

<LegalPage
	title="Privacy Policy"
	description="Learn how Mekan PLC collects, uses, and protects your personal information."
	lead="Your Data. Your Trust. Our Responsibility."
	lastUpdated="May 13, 2026"
	sections={sections}
	cta={{
		title: 'Questions About Your Privacy?',
		text: "We're committed to protecting your data. If you have any questions about our privacy practices, our team is here to help.",
		emailLabel: 'Email Privacy Team',
	}}
>
	<LegalSection id="introduction" num="1" title="Introduction">
		<p>Mekan Quality Management &amp; Training PLC respects your privacy and is committed to protecting your personal data. This privacy policy explains how we collect, use, and safeguard your information when you use our website and services. By using our website, you agree to the practices described in this policy.</p>
	</LegalSection>

	<LegalSection id="information" num="2" title="Information We Collect">
		<p>We collect information you provide directly to us, including:</p>
		<ul>
			<li><strong>Personal Information:</strong> Name, email address, phone number that you provide through our contact form.</li>
			<li><strong>Service Preferences:</strong> Information about the agribusiness services you're interested in.</li>
			<li><strong>Communication Data:</strong> Messages and inquiries you send to us.</li>
			<li><strong>Technical Information:</strong> IP address, browser type for security and analytics.</li>
		</ul>
	</LegalSection>

	<LegalSection id="usage" num="3" title="How We Use Your Information">
		<p>Mekan uses your personal information for:</p>
		<ul>
			<li><strong>Responding to Inquiries:</strong> Contacting you regarding your agribusiness consulting needs.</li>
			<li><strong>Service Delivery:</strong> Providing the investment advisory and consulting services you requested.</li>
			<li><strong>Communication:</strong> Sending updates about our services and responses to your questions.</li>
			<li><strong>Legal Compliance:</strong> Complying with applicable laws and regulations.</li>
		</ul>
	</LegalSection>

	<LegalSection id="security" num="4" title="Data Security">
		<p>We take the security of your personal information seriously:</p>
		<ul>
			<li>Your data is stored on secure servers with industry-standard encryption.</li>
			<li>Access is restricted to authorized Mekan personnel only.</li>
			<li>We implement technical and organizational measures to protect against unauthorized access.</li>
			<li>Your information is retained for up to 2 years after our last interaction.</li>
		</ul>
	</LegalSection>

	<LegalSection id="rights" num="5" title="Your Rights">
		<p>Depending on your location, you have the following rights:</p>
		<ul>
			<li><strong>Access:</strong> Request a copy of the personal information we hold about you.</li>
			<li><strong>Correction:</strong> Request that we correct inaccurate or incomplete information.</li>
			<li><strong>Deletion:</strong> Request that we delete your personal information.</li>
			<li><strong>Objection:</strong> Object to certain types of processing.</li>
		</ul>
	</LegalSection>

	<LegalSection id="contact" num="6" title="Contact Us">
		<p>If you have any questions about this privacy policy or our data practices, please contact us at <a href="mailto:biniam@mekanplc.com">biniam@mekanplc.com</a>.</p>
	</LegalSection>
</LegalPage>
