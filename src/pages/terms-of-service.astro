---
import LegalPage from '../components/LegalPage.astro';
import LegalSection from '../components/LegalSection.astro';

const sections = [
	{ id: 'acceptance', num: '1', title: 'Acceptance of Terms' },
	{ id: 'services', num: '2', title: 'Services Description' },
	{ id: 'website-use', num: '3', title: 'Website Use' },
	{ id: 'intellectual', num: '4', title: 'Intellectual Property' },
	{ id: 'consulting', num: '5', title: 'Consulting Services' },
	{ id: 'disclaimer', num: '6', title: 'Disclaimer' },
	{ id: 'liability', num: '7', title: 'Limitation of Liability' },
	{ id: 'governing', num: '8', title: 'Governing Law' },
	{ id: 'contact', num: '9', title: 'Contact Us' },
];
---

<LegalPage
	title="Terms of Service"
	description="Terms and conditions governing the use of Mekan PLC's website and services."
	lead="Please read these terms carefully before using our services."
	lastUpdated="May 13, 2026"
	sections={sections}
	cta={{
		title: 'Questions About Our Terms?',
		text: "We're here to help clarify any questions you may have about our terms of service.",
		emailLabel: 'Email Us',
	}}
>
	<LegalSection id="acceptance" num="1" title="Acceptance of Terms">
		<p>By accessing or using the Mekan website, you agree to be bound by these Terms of Service. If you do not agree to all the terms and conditions, please do not use our website or services.</p>
		<p>These terms constitute a legally binding agreement between you and Mekan Quality Management &amp; Training PLC, an agribusiness consulting firm registered in Ethiopia.</p>
	</LegalSection>

	<LegalSection id="services" num="2" title="Services Description">
		<p>Mekan provides professional consulting services in the agribusiness sector, including:</p>
		<ul>
			<li>Agribusiness development and strategic growth consulting</li>
			<li>Investment advisory services for agricultural projects</li>
			<li>Market research and analysis</li>
			<li>Sustainability and climate resilience solutions</li>
			<li>Quality assurance and regulatory compliance guidance</li>
		</ul>
	</LegalSection>

	<LegalSection id="website-use" num="3" title="Website Use">
		<p>You agree to use our website only for lawful purposes. Prohibited activities include:</p>
		<ul>
			<li>Using the website in any way that could damage or impair our servers</li>
			<li>Attempting to gain unauthorized access to any systems</li>
			<li>Transmitting viruses, malware, or other harmful code</li>
			<li>Using the contact form to send spam or unsolicited communications</li>
		</ul>
	</LegalSection>

	<LegalSection id="intellectual" num="4" title="Intellectual Property">
		<p>All content on this website is the property of Mekan and is protected by Ethiopian and international copyright laws.</p>
		<p><strong>You may:</strong> View, download, and print content for personal, non-commercial use. Share links on social media. Quote brief excerpts with proper attribution.</p>
		<p><strong>You may not:</strong> Reproduce, distribute, or modify content without permission. Use content for commercial purposes. Remove copyright notices.</p>
	</LegalSection>

	<LegalSection id="consulting" num="5" title="Consulting Services Agreement">
		<p>Engagement of our professional services is governed by separate written agreements:</p>
		<ul>
			<li><strong>Confidentiality:</strong> We maintain strict confidentiality of all client information</li>
			<li><strong>Professional Standards:</strong> Services performed per industry best practices</li>
			<li><strong>Payment Terms:</strong> Fees established in writing prior to project commencement</li>
			<li><strong>Intellectual Property:</strong> Work product becomes client property upon full payment</li>
		</ul>
	</LegalSection>

	<LegalSection id="disclaimer" num="6" title="Disclaimer of Warranties">
		<p>This website and content are provided "as is". Mekan makes no representations regarding:</p>
		<ul>
			<li>The accuracy or completeness of website content</li>
			<li>Uninterrupted or error-free operation of the website</li>
			<li>Results from using our consulting services</li>
		</ul>
		<p>All information is for informational purposes only and not professional advice.</p>
	</LegalSection>

	<LegalSection id="liability" num="7" title="Limitation of Liability">
		<p>To the fullest extent permitted by law, Mekan shall not be liable for:</p>
		<ul>
			<li>Direct, indirect, incidental, or consequential damages</li>
			<li>Loss of profits, revenue, data, or business opportunities</li>
			<li>Personal injury or property damage</li>
		</ul>
	</LegalSection>

	<LegalSection id="governing" num="8" title="Governing Law and Dispute Resolution">
		<p>These Terms are governed by the laws of the Federal Democratic Republic of Ethiopia. Disputes shall be resolved through:</p>
		<ul>
			<li><strong>Good Faith Negotiation:</strong> Direct negotiation first</li>
			<li><strong>Mediation:</strong> Mutually agreed mediator if negotiation fails</li>
			<li><strong>Arbitration:</strong> Ethiopian Arbitration and Conciliation Center in Addis Ababa</li>
		</ul>
	</LegalSection>

	<LegalSection id="contact" num="9" title="Contact Information">
		<p>For questions regarding these Terms of Service, please contact us at <a href="mailto:biniam@mekanplc.com">biniam@mekanplc.com</a>.</p>
	</LegalSection>
</LegalPage>
