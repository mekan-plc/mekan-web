---
import ErrorPage from '../components/ErrorPage.astro';
---

<ErrorPage
	code="404"
	title="Page Not Found"
	description="The page you're looking for doesn't exist. Explore Mekan PLC services, projects, or get in touch with us."
	heading="Oops! Page Not Found"
	message="The page you're looking for seems to have wandered off. Don't worry — we're here to help you find what you need."
>
	<a href="/" class="btn btn-primary h-12 px-6">
		<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
		Back to Home
	</a>
	<a href="/#contact" class="btn btn-secondary h-12 px-6">
		<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
		Contact Us
	</a>
</ErrorPage>
