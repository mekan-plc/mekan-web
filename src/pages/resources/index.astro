---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';

// Line icons (24px grid, 1.75px stroke, guide §9).
const icons = {
	document: ['M6.5 3.5h7l4 4v12a1 1 0 0 1-1 1h-10a1 1 0 0 1-1-1v-15a1 1 0 0 1 1-1Z', 'M13.5 3.5v4h4M8.5 12h7M8.5 15.5h7'],
	check: ['M5 13l4 4L19 7'],
	download: ['M12 4v11m0 0l-4-4m4 4l4-4M5 20h14'],
	phone: ['M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z'],
	mail: ['M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'],
	archive: ['M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10']
};
---

<Layout title="Resources" description="Free resources from Mekan PLC on quality management systems, compliance, certification readiness, and training for agribusiness in Ethiopia." overlayNav>
	<PageHero
		title="Free Resources"
		breadcrumbs={[{ label: 'Resources' }]}
		lead="Downloadable guides, checklists, and practical tools designed to support agribusiness growth, complemented by expert insights available at no cost."
	/>

	<section class="section bg-page">
		<div class="container">
			<p id="resourcesError" class="alert-danger mb-6 hidden" role="alert"></p>

			<div id="filterBar" class="mb-10 hidden flex-wrap items-center gap-3">
				<span id="filterLabel" class="text-small text-muted">Filter by category:</span>
				<div id="category-filters" class="flex flex-wrap gap-2" role="group" aria-labelledby="filterLabel"></div>
			</div>

			<div id="active-filter" class="mb-6 hidden text-small" aria-live="polite">
				<span class="text-muted">Showing: </span>
				<span id="active-filter-name" class="font-medium text-brand">All</span>
				<button id="clear-filter" type="button" class="link ml-2 text-small">Clear filter</button>
			</div>

			<div id="resources-grid" class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" aria-busy="true">
				{/* Loading skeletons, replaced once resources arrive */}
				{Array.from({ length: 6 }).map(() => (
					<div class="card overflow-hidden" aria-hidden="true">
						<div class="aspect-[16/10] animate-pulse border-b border-line bg-tint-brand"></div>
						<div class="space-y-3 p-6 md:p-7">
							<div class="h-5 w-4/5 animate-pulse rounded-full bg-line"></div>
							<div class="h-3 w-full animate-pulse rounded-full bg-line"></div>
							<div class="h-3 w-5/6 animate-pulse rounded-full bg-line"></div>
						</div>
					</div>
				))}
			</div>

			{/* Contact callout */}
			<div class="mt-16 rounded-card bg-tint-brand p-8 text-center md:p-10">
				<h2 class="text-h3 text-heading">Need custom resources?</h2>
				<p class="mx-auto mt-2 max-w-prose text-muted">Why don't you reach out to us directly? We're here to help.</p>
				<div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
					<a href="tel:+251911454671" class="btn btn-primary">
						<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
							{icons.phone.map((d) => <path d={d} />)}
						</svg>
						Call us
					</a>
					<a href="mailto:biniam@mekanplc.com" class="btn btn-secondary">
						<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
							{icons.mail.map((d) => <path d={d} />)}
						</svg>
						Email us
					</a>
				</div>
			</div>
		</div>
	</section>

	{/* Blueprints the script clones (data-field hooks). Hidden divs, not <template>: the Astro
	     compiler re-opens an <a> nested inside a <template> after it closes, leaking a stray link. */}
	<div id="resourceCardTemplate" hidden>
		<article class="card flex flex-col overflow-hidden">
			<div class="relative aspect-[16/10] overflow-hidden border-b border-line bg-tint-brand" data-field="media">
				<div class="flex h-full items-center justify-center text-brand/40" aria-hidden="true" data-field="placeholder">
					<svg class="h-10 w-10" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
						{icons.document.map((d) => <path d={d} />)}
					</svg>
				</div>
				<span class="badge badge-brand absolute left-4 top-4" data-field="category"></span>
			</div>
			<div class="flex flex-grow flex-col p-6 md:p-7">
				<h3 class="text-h3 text-heading" data-field="title"></h3>
				<p class="mt-3 flex-grow text-small text-muted" data-field="description"></p>
				<ul class="mt-5 space-y-2 border-t border-line pt-5" data-field="features"></ul>
				<div class="mt-6 flex items-center justify-between gap-4 border-t border-line pt-5">
					<span class="text-small text-muted" data-field="meta"></span>
					<a class="btn btn-primary h-10 px-4" target="_blank" rel="noopener noreferrer" data-field="download">
						<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
							{icons.download.map((d) => <path d={d} />)}
						</svg>
						Download PDF
					</a>
					<span class="text-small text-muted" data-field="no-file">No file available</span>
				</div>
			</div>
		</article>
	</div>

	<div id="resourceFeatureTemplate" hidden>
		<li class="flex items-start gap-2 text-small text-ink">
			<svg class="mt-0.5 h-4 w-4 shrink-0 text-accent" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
				{icons.check.map((d) => <path d={d} />)}
			</svg>
			<span></span>
		</li>
	</div>

	<div id="resourcesEmptyTemplate" hidden>
		<div class="col-span-full px-4 py-16 text-center">
			<span class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-card bg-tint-brand text-brand" aria-hidden="true">
				<svg class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
					{icons.archive.map((d) => <path d={d} />)}
				</svg>
			</span>
			<h2 class="text-h3 text-heading">Resources Coming Soon</h2>
			<p class="mx-auto mt-2 max-w-md text-muted">
				We're curating valuable resources for you. Check back soon for guides, templates, and industry insights!
			</p>
			<a href="/#contact" class="btn btn-primary mt-6">
				<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
					{icons.mail.map((d) => <path d={d} />)}
				</svg>
				Contact Us
			</a>
		</div>
	</div>

	<script>
		type Resource = {
			title?: string;
			description?: string;
			category?: string;
			imageUrl?: string | null;
			features?: string[];
			downloadUrl?: string;
			fileSize?: string;
		};

		const CMS_BASE = (import.meta.env.PUBLIC_CMS_BASE_URL || 'http://localhost:8881').replace(/\/$/, '');
		const filterBar = document.getElementById('filterBar');
		const filtersWrap = document.getElementById('category-filters');
		const grid = document.getElementById('resources-grid');
		const errorEl = document.getElementById('resourcesError');
		const activeFilterDiv = document.getElementById('active-filter');
		const activeFilterName = document.getElementById('active-filter-name');
		const clearFilterBtn = document.getElementById('clear-filter');
		const cardTemplate = document.getElementById('resourceCardTemplate') as HTMLElement | null;
		const featureTemplate = document.getElementById('resourceFeatureTemplate') as HTMLElement | null;
		const emptyTemplate = document.getElementById('resourcesEmptyTemplate') as HTMLElement | null;
		const CACHE_TTL_MS = 5 * 60 * 1000;
		const CACHE_PREFIX = 'mekan_cache_v1:';
		const DEFAULT_CATEGORIES = ['Certification', 'Compliance', 'Sustainability', 'Strategy', 'Coffee', 'Finance'];

		function cacheGet(key: string) {
			try {
				const raw = sessionStorage.getItem(CACHE_PREFIX + key);
				if (!raw) return null;
				const parsed = JSON.parse(raw);
				if (!parsed || typeof parsed !== 'object') return null;
				if (typeof parsed.ts !== 'number') return null;
				if (Date.now() - parsed.ts > CACHE_TTL_MS) return null;
				return parsed.data ?? null;
			} catch {
				return null;
			}
		}

		function cacheSet(key: string, data: unknown) {
			try {
				sessionStorage.setItem(CACHE_PREFIX + key, JSON.stringify({ ts: Date.now(), data }));
			} catch {
				// ignore
			}
		}

		// Text goes in through textContent, so CMS strings never become markup.
		function resourceCard(resource: Resource): HTMLElement {
			const card = (cardTemplate!.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
			const field = <T extends HTMLElement = HTMLElement>(name: string) => card.querySelector<T>(`[data-field="${name}"]`);
			const category = resource.category || 'General';
			card.dataset.category = category;

			field('category')!.textContent = category;
			field('title')!.textContent = resource.title || '';
			field('description')!.textContent = resource.description || '';
			// File type and size only when there is a file to download.
			field('meta')!.textContent = resource.downloadUrl ? ['PDF', resource.fileSize].filter(Boolean).join(' · ') : '';

			if (resource.imageUrl) {
				const img = document.createElement('img');
				img.src = resource.imageUrl;
				img.alt = resource.title || '';
				img.loading = 'lazy';
				img.decoding = 'async';
				img.className = 'absolute inset-0 h-full w-full object-cover';
				field('placeholder')?.replaceWith(img);
			}

			const features = field('features')!;
			if (Array.isArray(resource.features) && resource.features.length > 0 && featureTemplate) {
				features.replaceChildren(...resource.features.map((text) => {
					const item = featureTemplate.firstElementChild!.cloneNode(true) as HTMLElement;
					item.querySelector('span')!.textContent = text;
					return item;
				}));
			} else {
				features.remove();
			}

			const download = field<HTMLAnchorElement>('download')!;
			if (resource.downloadUrl) {
				download.href = resource.downloadUrl;
				download.download = `${String(resource.title || 'resource').replace(/\s+/g, '_')}.pdf`;
				field('no-file')?.remove();
			} else {
				download.remove();
			}

			return card;
		}

		function renderFilters(categories: string[]) {
			if (!filtersWrap) return;
			filtersWrap.replaceChildren(...categories.map((cat, i) => {
				const btn = document.createElement('button');
				btn.type = 'button';
				btn.className = 'chip';
				btn.dataset.category = cat;
				btn.textContent = cat;
				btn.setAttribute('aria-pressed', String(i === 0));
				return btn;
			}));
			filterBar?.classList.replace('hidden', 'flex');
		}

		function filterResources(category: string) {
			filtersWrap?.querySelectorAll<HTMLButtonElement>('.chip').forEach((btn) => {
				btn.setAttribute('aria-pressed', String(btn.dataset.category === category));
			});
			grid?.querySelectorAll<HTMLElement>('article[data-category]').forEach((card) => {
				card.classList.toggle('hidden', !(category === 'All' || card.dataset.category === category));
			});
			if (activeFilterDiv && activeFilterName) {
				activeFilterDiv.classList.toggle('hidden', category === 'All');
				activeFilterName.textContent = category;
			}
		}

		filtersWrap?.addEventListener('click', (event) => {
			const btn = (event.target as HTMLElement).closest<HTMLButtonElement>('.chip');
			if (btn?.dataset.category) filterResources(btn.dataset.category);
		});
		clearFilterBtn?.addEventListener('click', () => filterResources('All'));

		function renderEmpty() {
			if (!grid || !emptyTemplate) return;
			grid.replaceChildren(emptyTemplate.firstElementChild!.cloneNode(true));
			grid.setAttribute('aria-busy', 'false');
			filterBar?.classList.replace('flex', 'hidden');
		}

		function renderResources(resources: Resource[]) {
			if (!grid || !cardTemplate) return;
			if (resources.length === 0) return renderEmpty();
			const resourceCats = Array.from(new Set(resources.map((r) => r.category).filter(Boolean))) as string[];
			const categories = ['All', ...DEFAULT_CATEGORIES.filter((c) => resourceCats.includes(c)), ...resourceCats.filter((c) => !DEFAULT_CATEGORIES.includes(c))];
			renderFilters(categories);
			grid.replaceChildren(...resources.map(resourceCard));
			grid.setAttribute('aria-busy', 'false');
			filterResources('All');
		}

		async function loadResources() {
			const cachedResources = cacheGet('resources:index');
			if (cachedResources && Array.isArray(cachedResources)) renderResources(cachedResources);
			try {
				const url = `${CMS_BASE}/wp-json/mekan/v1/resources?per_page=100`;
				const res = await fetch(url, { headers: { Accept: 'application/json' } });
				if (!res.ok) throw new Error('Failed to load resources.');
				const resources = await res.json();
				if (!Array.isArray(resources)) throw new Error('Invalid resources response.');
				cacheSet('resources:index', resources);
				renderResources(resources);
			} catch {
				if (!cachedResources) {
					renderEmpty();
					errorEl?.classList.add('hidden');
				}
			}
		}

		loadResources();
	</script>
</Layout>
