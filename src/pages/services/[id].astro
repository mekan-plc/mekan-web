---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';

export function getStaticPaths() {
	const serviceIds = [
		'quality-assurance',
		'agribusiness-development',
		'agricultural-productivity',
		'food-systems',
		'global-standards',
		'investment-advisory'
	];
	return serviceIds.map(id => ({ params: { id } }));
}

const services = {
	'quality-assurance': {
		title: 'Quality Assurance & Regulatory Compliance',
		description: 'Securing your license to operate in a global marketplace.',
		images: [
			'/gallery/photo_1.jpg', '/gallery/photo_2.jpg', '/gallery/photo_3.jpg',
			'/gallery/photo_4.jpg', '/gallery/photo_5.jpg', '/gallery/photo_6.jpg',
			'/gallery/photo_7.jpg', '/gallery/photo_8.jpg'
		],
		about: [
			'In an increasingly regulated global landscape, compliance has become the cornerstone of market trust and competitiveness. We provide the technical framework and end-to-end oversight necessary to ensure your agribusiness fully aligns with private label standards and internationally recognized requirements.',
			'Our approach strengthens food safety systems, regulatory compliance, and responsible business practices across the value chain. In doing so, we help safeguard product integrity, unlock access to premium markets, and minimize operational and reputational risks.'
		],
		features: [
			'Food Safety & Total System Compliance (GAP, GHP, GMP, HACCP, BRCGS, FSMS 22000)',
			'For private label standards, we deliver bespoke, brand-specific compliance solutions tailored to individual needs.',
			'EU Market Entry & Regulatory Guidance for export readiness',
			'Corporate Stewardship (CSR, ESG & ESMS) integration and reporting',
			'Occupational Health & Safety (OHS) protocols and risk management',
			'Environmental Benchmarking and global environmental alignment',
			'Gap Analysis & Risk Audits with corrective action planning',
			'Third-Party Representation during international certification audits'
		],
		benefits: [
			'Access to premium international markets',
			'Reduced compliance risks and penalties',
			'Improved product quality and safety',
			'Enhanced brand reputation and trust',
			'Streamlined certification processes'
		]
	},
	'agribusiness-development': {
		title: 'Agribusiness Development & Strategic Growth',
		description: 'Transforming agricultural potential into competitive commercial enterprises.',
		images: [
			'/gallery/photo_9.jpg', '/gallery/photo_10.jpg', '/gallery/photo_11.jpg',
			'/gallery/photo_12.jpg', '/gallery/photo_13.jpg', '/gallery/photo_14.jpg',
			'/gallery/photo_15.jpg', '/gallery/photo_16.jpg'
		],
		about: [
			'Scaling an agribusiness requires a sophisticated blend of agronomic precision and corporate strategy. We empower enterprises to optimize their value chains and achieve sustainable growth.',
			'From strategy development and investment-ready business plans to performance monitoring and coaching, we support leadership teams with practical tools and implementation support.'
		],
		features: [
			'Strategic Transformation of Agribusiness for Scale and Competitive Advantage',
			'Development of bespoke, investment-ready agronomy business plans for SMEs.',
			'High-Level Performance Monitoring and Executive Leadership Coaching',
			'Strategic Business Skills and Management Capacity Development Services',
			'Strategic Advisory for Human Resources and Project Optimization',
			'B2B Engagement, Value Chain Development, and Market Linkage Facilitation',
			'Long-term Strategic Planning and Resilience Building'
		],
		benefits: [
			'Increased operational efficiency',
			'Sustainable revenue growth',
			'Stronger market positioning',
			'Improved stakeholder management',
			'Access to new business opportunities'
		]
	},
	'agricultural-productivity': {
		title: 'Agricultural Productivity & Sustainability',
		description: 'Advancing food system resilience through regenerative, science-driven practices.',
		images: [
			'/gallery/photo_17.jpg', '/gallery/photo_18.jpg', '/gallery/photo_19.jpg',
			'/gallery/photo_20.jpg', '/gallery/photo_21.jpg', '/gallery/photo_22.jpg',
			'/gallery/photo_23.jpg', '/gallery/photo_24.jpg'
		],
		about: [
			'We believe that high-yield productivity must go hand in hand with ecological stewardship to safeguard long-term food security and business continuity.',
			'We support farms and agribusinesses through field-level standards, postharvest safety, and practical sustainability systems that enhance performance while conserving natural resources.'
		],
		features: [
			'Facilitate implementation of Good Agricultural Practices (GAP) Standards',
			'Specialized Support for Postharvest Handling and Food Safety Systems',
			'Delivery of training on safe chemical use and farm hygiene',
			'Expert guidance on Integrated Pest Management (IPM) strategy formulation and application',
			'Soil & Water Management guidance',
			'Support in the design, implementation, and optimization of Integrated Farm Management (IFM) systems.',
			'Technical support in natural resource governance and regenerative practices'
		],
		benefits: [
			'Higher crop yields and quality',
			'Reduced input costs and waste',
			'Improved environmental stewardship',
			'Better resource utilization',
			'Long-term farm viability'
		]
	},
	'food-systems': {
		title: 'Food Systems & Climate Resilience',
		description: 'Advancing resilient food systems for a dynamic and evolving global landscape.',
		images: [
			'/gallery/photo_25.jpg', '/gallery/photo_26.jpg', '/gallery/photo_27.jpg',
			'/gallery/photo_28.jpg', '/gallery/photo_29.jpg', '/gallery/photo_30.jpg',
			'/gallery/photo_31.jpg', '/gallery/photo_32.jpg'
		],
		about: [
			'As global food systems face unprecedented pressure, we support our clients in strengthening resilience against environmental, social, and policy-related risks.',
			'Through diagnostics, strategy development, and practical resilience tools, we help our partners achieve measurable results and long-term stability.'
		],
		features: [
			'Deliver comprehensive, high-level food systems assessment and diagnostic services.',
			'Policy & Strategy Development',
			'Offer robust climate resilience and risk management frameworks',
			'Offer specialized consultancy on Nutrition-Sensitive Programming design and implementation'
		],
		benefits: [
			'Identifies constraints to improve food security and efficiency',
			'Enhances climate resilience and adaptation',
			'Improves nutrition via integrated systems',
			'Strengthens institutions and policy coherence',
			'Builds investor confidence through measurable impact'
		]
	},
	'global-standards': {
		title: 'Global Standards & Certifications',
		description: 'Your technical partner for world-class accreditation.',
		images: [
			'/gallery/photo_33.jpg', '/gallery/photo_34.jpg', '/gallery/photo_35.jpg',
			'/gallery/photo_36.jpg', '/gallery/photo_37.jpg', '/gallery/photo_38.jpg',
			'/gallery/photo_39.jpg', '/gallery/photo_40.jpg'
		],
		about: [
			'We demystify the certification journey, providing the technical oversight needed to secure the industry’s most respected seals of quality.',
			'From readiness assessments to documentation, implementation support, and audit accompaniment, we help you become audit-ready with confidence.'
		],
		features: [
			'GlobalG.A.P and GRASP',
			'BRCGS, IFS, HACCP, FSMS 22000',
			'Organic certification support',
			'Tesco Nurture, LEAF',
			'SEDEX / SMETA'
		],
		benefits: [
			'Clear, structured certification roadmap',
			'Higher audit readiness and confidence',
			'Stronger buyer and market trust',
			'Improved internal systems and documentation'
		]
	},
	'investment-advisory': {
		title: 'Private Sector & Investment Advisory',
		description: 'Transforming data into actionable intelligence that drives informed decision-making for investors and stakeholders.',
		images: [
			'/gallery/photo_41.jpg', '/gallery/photo_42.jpg', '/gallery/photo_43.jpg',
			'/gallery/photo_44.jpg', '/gallery/photo_45.jpg', '/gallery/photo_46.jpg',
			'/gallery/photo_47.jpg', '/gallery/photo_48.jpg', '/gallery/photo_49.jpg',
			'/gallery/photo_50.jpg', '/gallery/photo_51.jpg', '/gallery/photo_52.jpg',
			'/gallery/photo_53.jpg', '/gallery/photo_54.jpg'
		],
		about: [
			'For investors and private sector entities, we act as an analytical bridge between capital investment and agricultural performance, delivering data-driven insights that inform strategic decision-making and enhance impact.',
			'We provide comprehensive support across planning, Monitoring, Evaluation and Learning (MEL), modelling, and implementation, ensuring that projects achieve measurable outcomes, operational efficiency, and strong value for money.'
		],
		features: [
			'Supply Chain & Logistics Optimization (data modelling)',
			'Monitoring, Evaluation & Learning (MEL) systems',
			'Project Design & Implementation support',
			'Investment Readiness Advisory',
			'Data Modelling & Decision Support'
		],
		benefits: [
			'Better investment decisions and clarity',
			'Stronger project performance and accountability',
			'Improved supply chain efficiency',
			'Actionable insights from complex data'
		]
	}
};

const deliveryApproach = [
	{
		title: 'Strategic Consultation',
		description: 'High-level advisory for executive decision-making.'
	},
	{
		title: 'Capacity Building & Training',
		description: 'Practical, field-level skills transfer.'
	},
	{
		title: 'Coaching & Mentorship',
		description: 'Sustained professional development support designed to strengthen the capabilities of stakeholders'
	},
	{
		title: 'Research & Evaluation',
		description: 'Evidence-based insights supported by rigorous, data-driven project assessment'
	},
	{
		title: 'Gap Analysis & Risk Audits',
		description: 'Identifying operational gaps and risks early to prevent financial and operational impacts.'
	},
	{
		title: 'Document Preparation',
		description: 'Development of technical manuals and SOPs for international audit compliance.'
	},
	{
		title: 'Third-Party Representation',
		description: 'Representing you in national and international certification audits to ensure compliance and effective engagement'
	}
];

const { id } = Astro.params;
const service = id && services[id as keyof typeof services];

if (!service) {
	return Astro.redirect('/#services');
}

/**
 * Service Schema.org Structured Data (JSON-LD)
 * 
 * Implements schema.org/Service markup to help search engines understand
 * this page represents a professional consulting service. This enables:
 * - Rich snippets in search results
 * - Service-specific SEO enhancements
 * - Better visibility for "consulting Ethiopia" searches
 * 
 * @see https://schema.org/Service
 */
const requestOrigin = Astro.request?.url ? new URL(Astro.request.url).origin : '';
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || requestOrigin).replace(/\/$/, '');
const pageUrl = siteUrl ? new URL(Astro.url.pathname, siteUrl).toString() : Astro.url.pathname;

const serviceLd = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: service.title,
	description: service.description,
	url: pageUrl,
	provider: {
		'@type': 'Organization',
		name: 'Mekan PLC',
		url: siteUrl || undefined,
		logo: siteUrl ? new URL('/logo1.2.png', siteUrl).toString() : '/logo1.2.png',
		contactPoint: {
			'@type': 'ContactPoint',
			contactType: 'sales',
			email: 'biniam@mekanplc.com',
			telephone: '+251911454671',
			availableLanguage: ['English']
		}
	},
	areaServed: {
		'@type': 'Place',
		name: 'Ethiopia'
	},
	serviceType: 'Consulting'
};

// Line icons (24px grid, 1.75px stroke, guide §9).
const checkIcon = 'M5 13l4 4L19 7';
const contactActions = [
	{
		label: 'Call us',
		href: 'tel:+251911454671',
		icon: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z'
	},
	{
		label: 'Email us',
		href: 'mailto:biniam@mekanplc.com',
		icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'
	}
];
---

<Layout title={service.title} overlayNav>
	<script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
	<PageHero
		title={service.title}
		breadcrumbs={[{ label: 'Services', href: '/#services' }, { label: service.title }]}
		lead={service.description}
	/>

	<section class="section bg-page">
		<div class="container">
			<div class="max-w-prose">
				<h2 class="section-title">About The Service</h2>
				<div class="mt-6 space-y-4 text-ink/85">
					{(service.about ?? []).map((para) => <p>{para}</p>)}
				</div>
			</div>
		</div>
	</section>

	{/* What we offer, with the benefits and contact actions in a sticky card */}
	<section class="section border-t border-line bg-page">
		<div class="container">
			<div class="grid gap-12 lg:grid-cols-3 lg:gap-10">
				<div class="lg:col-span-2">
					<h2 class="section-title">What we offer</h2>
					<ul class="mt-8 grid gap-4 sm:grid-cols-2">
						{service.features.map((feature) => (
							<li class="card flex items-start gap-4 p-5">
								<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-control bg-tint-accent text-accent ring-1 ring-inset ring-accent/20" aria-hidden="true">
									<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d={checkIcon} />
									</svg>
								</span>
								<span class="pt-1 text-small text-ink">{feature}</span>
							</li>
						))}
					</ul>
				</div>

				<aside class="lg:pt-2">
					<div class="card p-6 md:p-7 lg:sticky lg:top-28">
						<h3 class="text-h3 text-heading">Key Benefits</h3>
						<ul class="mt-5 space-y-3">
							{service.benefits.map((benefit) => (
								<li class="flex items-start gap-3 text-small text-ink/85">
									<svg class="mt-0.5 h-4 w-4 shrink-0 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d={checkIcon} />
									</svg>
									<span>{benefit}</span>
								</li>
							))}
						</ul>
						<div class="mt-7 border-t border-line pt-6">
							<a href="/#contact" class="btn btn-primary w-full">
								Get started
								<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M17 8l4 4m0 0l-4 4m4-4H3" />
								</svg>
							</a>
							<div class="mt-3 grid grid-cols-2 gap-3">
								{contactActions.map((action) => (
									<a href={action.href} class="btn btn-secondary px-3">
										<svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d={action.icon} />
										</svg>
										{action.label}
									</a>
								))}
							</div>
						</div>
					</div>
				</aside>
			</div>
		</div>
	</section>

	<section class="section border-t border-line bg-page">
		<div class="container">
			<div class="mx-auto mb-12 max-w-2xl text-center">
				<p class="eyebrow">Our delivery</p>
				<h2 class="section-title mt-4">Tailored solutions designed for diverse organizational landscapes</h2>
				<p class="lead mt-4">
					We do not subscribe to one-size-fits-all solutions. Our methodology is flexible and designed to ensure the seamless integration of our expertise into your existing operations.
				</p>
			</div>
			{/* 4 + 3 on desktop: the first four take 3 of 12 columns, the last three take 4 */}
			<ul class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-12">
				{deliveryApproach.map((item, index) => (
					<li class:list={['card p-7', index < 4 ? 'lg:col-span-3' : 'lg:col-span-4']}>
						<span class="mb-5 block h-0.5 w-8 bg-accent" aria-hidden="true"></span>
						<h3 class="text-h3 text-heading">{item.title}</h3>
						<p class="mt-3 text-small text-muted">{item.description}</p>
					</li>
				))}
			</ul>
		</div>
	</section>

	{/* Our work: a photo gallery that opens on demand */}
	<section class="section border-t border-line bg-page">
		<div class="container">
			<div class="mx-auto max-w-2xl text-center">
				<p class="eyebrow">Portfolio</p>
				<h2 class="section-title mt-4">Our Work</h2>
				<p class="lead mt-4">
					Discover tangible results from our {service.title.toLowerCase()} initiatives across Ethiopia.
				</p>
				<button
					id="gallery-toggle"
					type="button"
					class="btn btn-secondary mt-8 h-12 px-6"
					aria-expanded="false"
					aria-controls="work-gallery"
				>
					<span id="toggle-text">View our projects</span>
					<svg id="toggle-icon" class="h-4 w-4 transition-transform duration-fast ease-out" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M19 9l-7 7-7-7" />
					</svg>
				</button>
			</div>

			<div id="work-gallery" class="work-gallery grid" inert>
				<div class="min-h-0 overflow-hidden">
					<ul class="grid grid-cols-2 gap-4 pt-10 md:grid-cols-3 lg:grid-cols-4">
						{service.images?.map((img, index) => (
							<li class="aspect-[4/3] overflow-hidden rounded-card border border-line bg-tint-brand">
								<img
									src={img}
									alt={`${service.title} project ${index + 1}`}
									class="h-full w-full object-cover"
									loading="lazy"
									decoding="async"
								/>
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<style>
		/* Collapsed by default; opens with a steady height + fade (guide §9). */
		.work-gallery {
			grid-template-rows: 0fr;
			opacity: 0;
			transition:
				grid-template-rows var(--mk-duration-reveal) var(--mk-ease-out),
				opacity var(--mk-duration-reveal) var(--mk-ease-out);
		}

		.work-gallery.is-open {
			grid-template-rows: 1fr;
			opacity: 1;
		}
	</style>

	<script>
		const toggleBtn = document.getElementById('gallery-toggle');
		const gallery = document.getElementById('work-gallery');
		const toggleText = document.getElementById('toggle-text');
		const toggleIcon = document.getElementById('toggle-icon');

		toggleBtn?.addEventListener('click', () => {
			if (!gallery) return;
			const isOpen = gallery.classList.toggle('is-open');
			// Closed photos stay out of the tab order and the accessibility tree.
			gallery.inert = !isOpen;
			toggleBtn.setAttribute('aria-expanded', String(isOpen));
			if (toggleText) toggleText.textContent = isOpen ? 'Hide projects' : 'View our projects';
			toggleIcon?.classList.toggle('rotate-180', isOpen);
		});
	</script>
</Layout>
