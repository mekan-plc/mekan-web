---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import BlogCard from '../../components/BlogCard.astro';
---

<Layout title="Blog" description="Insights from Mekan PLC on quality management, compliance, certification readiness, and training for agribusiness in Ethiopia." overlayNav>
	<PageHero
		title="Insights & Blog"
		breadcrumbs={[{ label: 'Blog' }]}
		lead="Latest thinking on quality standards, market access, sustainable agriculture, and agribusiness growth strategies."
	/>

	<section class="section bg-page">
		<div class="container">
			<div id="blogError" class="alert-danger mb-8 hidden" role="alert"></div>
			<div id="blogGrid" class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" aria-live="polite" aria-busy="true">
				{/* Loading skeletons, replaced once posts arrive */}
				{Array.from({ length: 6 }).map(() => (
					<div class="card overflow-hidden" aria-hidden="true">
						<div class="aspect-[16/10] animate-pulse border-b border-line bg-tint-accent"></div>
						<div class="space-y-3 p-6 md:p-7">
							<div class="h-3 w-1/3 animate-pulse rounded-full bg-line"></div>
							<div class="h-5 w-4/5 animate-pulse rounded-full bg-line"></div>
							<div class="h-3 w-full animate-pulse rounded-full bg-line"></div>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<template id="blogCardTemplate">
		<BlogCard href="#" title="" category="Category" />
	</template>

	<template id="blogEmptyTemplate">
		<p class="col-span-full py-16 text-center text-muted">No blog posts found. Check back soon!</p>
	</template>

	<script>
		import { fillBlogCard, type BlogCardData } from '../../scripts/blog-card';

		const CMS_BASE = (import.meta.env.PUBLIC_CMS_BASE_URL || 'http://localhost:8881').replace(/\/$/, '');
		const grid = document.getElementById('blogGrid');
		const errorEl = document.getElementById('blogError');
		const cardTemplate = document.getElementById('blogCardTemplate') as HTMLTemplateElement | null;
		const emptyTemplate = document.getElementById('blogEmptyTemplate') as HTMLTemplateElement | null;
		const CACHE_TTL_MS = 5 * 60 * 1000;
		const CACHE_PREFIX = 'mekan_cache_v1:';

		function cacheGet(key: string) {
			try {
				const raw = sessionStorage.getItem(CACHE_PREFIX + key);
				if (!raw) return null;
				const parsed = JSON.parse(raw);
				if (!parsed || typeof parsed !== 'object') return null;
				if (typeof parsed.ts !== 'number') return null;
				if (Date.now() - parsed.ts > CACHE_TTL_MS) return null;
				return parsed.data ?? null;
			} catch {
				return null;
			}
		}

		function cacheSet(key: string, data: unknown) {
			try {
				sessionStorage.setItem(CACHE_PREFIX + key, JSON.stringify({ ts: Date.now(), data }));
			} catch {
				// ignore
			}
		}

		function setFallbackFlag(on: boolean) {
			try {
				if (on) localStorage.setItem('mekan_da_fallback', '1');
				else localStorage.removeItem('mekan_da_fallback');
			} catch {
				// ignore
			}
		}

		function renderBlogs(blogs: BlogCardData[]) {
			if (!grid || !cardTemplate) return;
			if (blogs.length === 0 && emptyTemplate) {
				grid.replaceChildren(emptyTemplate.content.cloneNode(true));
			} else {
				grid.replaceChildren(...blogs.map((blog) => fillBlogCard(cardTemplate, blog)));
			}
			grid.setAttribute('aria-busy', 'false');
			setupPrefetching();
		}

		async function prefetchBlogSlug(slug: string) {
			const key = `blog:${slug}`;
			if (cacheGet(key)) return;
			try {
				const url = `${CMS_BASE}/wp-json/mekan/v1/blogs/${encodeURIComponent(slug)}`;
				const res = await fetch(url, { headers: { Accept: 'application/json' } });
				if (!res.ok) return;
				const blog = await res.json();
				cacheSet(key, blog);
			} catch {
				// ignore
			}
		}

		function setupPrefetching() {
			const links = Array.from(grid?.querySelectorAll<HTMLAnchorElement>('a[data-slug]') ?? []);
			links.forEach((a) => {
				a.addEventListener('mouseenter', () => {
					const slug = a.dataset.slug;
					if (slug) prefetchBlogSlug(slug);
				});
				a.addEventListener('touchstart', () => {
					const slug = a.dataset.slug;
					if (slug) prefetchBlogSlug(slug);
				}, { passive: true });
			});

			if ('IntersectionObserver' in window) {
				const io = new IntersectionObserver((entries) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;
						const a = entry.target as HTMLAnchorElement;
						const slug = a.dataset.slug;
						if (slug) prefetchBlogSlug(slug);
						io.unobserve(a);
					});
				}, { rootMargin: '250px' });
				links.forEach((a) => io.observe(a));
			}
		}

		const STATIC_BLOGS: BlogCardData[] = [
			{
				slug: 'sample-1',
				title: 'Introduction to GLOBALG.A.P Certification for Ethiopian Exporters',
				excerpt: 'Learn how GLOBALG.A.P certification opens doors to European markets and enhances food safety standards for Ethiopian agricultural producers.',
				category: 'Certification',
				date: 'January 15, 2026',
				imageUrl: null
			},
			{
				slug: 'sample-2',
				title: 'Maximizing Coffee Quality: Post-Harvest Processing Best Practices',
				excerpt: 'Discover the critical steps in coffee processing that can increase your cupping scores by 2-3 points and attract premium buyers.',
				category: 'Coffee',
				date: 'January 10, 2026',
				imageUrl: null
			},
			{
				slug: 'sample-3',
				title: 'Export Documentation Guide: From Farm to Port',
				excerpt: 'A comprehensive checklist of all documents needed for agricultural exports from Ethiopia, including phytosanitary certificates and customs declarations.',
				category: 'Export',
				date: 'January 5, 2026',
				imageUrl: null
			}
		];

		async function loadBlogs() {
			const cached = cacheGet('blogs:index');
			if (cached && Array.isArray(cached)) renderBlogs(cached);
			try {
				const url = `${CMS_BASE}/wp-json/mekan/v1/blogs?per_page=12`;
				const res = await fetch(url, { headers: { Accept: 'application/json' } });
				if (!res.ok) throw new Error('Failed to load blog posts.');
				const blogs = await res.json();
				if (!Array.isArray(blogs)) throw new Error('Invalid blogs response.');
				cacheSet('blogs:index', blogs);
				setFallbackFlag(false);
				renderBlogs(blogs);
			} catch {
				if (!cached) {
					setFallbackFlag(true);
					renderBlogs(STATIC_BLOGS);
					errorEl?.classList.add('hidden');
				}
			}
		}

		loadBlogs();
	</script>
</Layout>
