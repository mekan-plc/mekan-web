---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getBlogBySlug } from '../../lib/wp';

export const prerender = false;

const { slug } = Astro.params;
const blog = await getBlogBySlug(slug);

// If blog not found, redirect to 404 page
if (!blog) {
	return Astro.redirect('/404', 404);
}

/**
 * BlogPosting Schema.org Structured Data (JSON-LD)
 *
 * Implements schema.org/BlogPosting markup for individual blog articles.
 * This structured data enables:
 * - Article rich snippets in Google search results
 * - Better indexing of blog content with proper author/publisher attribution
 * - Publication date visibility for time-sensitive content
 * - Featured image display in search results
 *
 * @see https://schema.org/BlogPosting
 * @see https://developers.google.com/search/docs/appearance/structured-data/article
 */
const requestOrigin = Astro.request?.url ? new URL(Astro.request.url).origin : '';
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || requestOrigin).replace(/\/$/, '');
const pageUrl = siteUrl ? new URL(Astro.url.pathname, siteUrl).toString() : Astro.url.pathname;
const imageUrl = blog.imageUrl || (siteUrl ? new URL('/logo1.2.png', siteUrl).toString() : '/logo1.2.png');

const blogPostingLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: blog.title,
	description: blog.excerpt || blog.title,
	image: imageUrl,
	url: pageUrl,
	datePublished: blog.date ? new Date(blog.date).toISOString() : new Date().toISOString(),
	author: {
		'@type': 'Organization',
		name: 'Mekan PLC',
		url: siteUrl || undefined
	},
	publisher: {
		'@type': 'Organization',
		name: 'Mekan PLC',
		logo: {
			'@type': 'ImageObject',
			url: siteUrl ? new URL('/logo1.2.png', siteUrl).toString() : '/logo1.2.png'
		}
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': pageUrl
	}
};

// Reading time from the real word count (about 200 words a minute), not a fixed figure.
const wordCount = (blog.content || '').replace(/<[^>]*>/g, ' ').split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));

// Share targets: one line icon colour (guide §9), labels kept.
const shareLinks = [
	{
		id: 'shareLinkedIn',
		label: 'LinkedIn',
		aria: 'Share on LinkedIn',
		icon: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z'
	},
	{
		id: 'shareTwitter',
		label: 'Twitter',
		aria: 'Share on Twitter',
		icon: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z'
	},
	{
		id: 'shareFacebook',
		label: 'Facebook',
		aria: 'Share on Facebook',
		icon: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z'
	}
];
---

<Layout title={blog.title} description={(blog.excerpt || '').slice(0, 160)} overlayNav>
	<script type="application/ld+json" set:html={JSON.stringify(blogPostingLd)} />
	<PageHero
		title={blog.title}
		eyebrow={blog.category || 'Blog'}
		breadcrumbs={[{ label: 'Blog', href: '/blog' }, { label: blog.title }]}
	>
		<ul class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-small text-on-brand/80">
			{blog.date && (
				<li class="flex items-center gap-2">
					<svg class="h-4 w-4 text-on-brand-accent" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
						<path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
					</svg>
					<span class="sr-only">Published:</span>
					{blog.date}
				</li>
			)}
			<li class="flex items-center gap-2">
				<svg class="h-4 w-4 text-on-brand-accent" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
				</svg>
				{readingMinutes} min read
			</li>
		</ul>
	</PageHero>

	<section class="section bg-page">
		<div class="container">
			<div class="mx-auto max-w-5xl">
				{blog.imageUrl && (
					<div class="mb-12 aspect-video overflow-hidden rounded-card border border-line bg-tint-accent">
						<img src={blog.imageUrl} alt={blog.title} class="h-full w-full object-cover" loading="eager" decoding="async" />
					</div>
				)}

				<div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-12">
					<div>
						{blog.excerpt && (
							<div class="rounded-card bg-tint-brand p-6 md:p-8">
								<p class="eyebrow">Summary</p>
								<p class="mt-3 text-lead text-ink">{blog.excerpt}</p>
							</div>
						)}

						<article class="prose prose-lg mt-10 max-w-none prose-img:border prose-img:border-line">
							<div set:html={blog.content}></div>
						</article>

						<div class="card mt-12 p-6 md:p-7">
							<h2 class="text-h3 text-heading">Share this article</h2>
							<div class="mt-5 grid grid-cols-3 gap-3">
								{shareLinks.map((link) => (
									<a id={link.id} href="#" target="_blank" rel="noopener noreferrer" class="btn btn-secondary px-3" aria-label={link.aria}>
										<svg class="h-4 w-4 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
											<path d={link.icon} />
										</svg>
										<span class="hidden sm:inline">{link.label}</span>
									</a>
								))}
							</div>
						</div>

						<a href="/blog" class="link mt-10 inline-flex items-center gap-2">
							<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M7 16l-4-4m0 0l4-4m-4 4h18" />
							</svg>
							Back to all blogs
						</a>
					</div>

					{/* Contact card: beside the article on desktop, below it on phones */}
					<aside class="lg:sticky lg:top-28 lg:self-start">
						<div class="brand-band rounded-card p-6">
							<h2 class="text-h3">Need Expert Help?</h2>
							<p class="mt-2 text-small text-on-brand/80">Our consultants can help you implement these strategies in your business.</p>
							<a href="/#contact" class="btn btn-primary mt-5">
								Contact Us
								<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M17 8l4 4m0 0l-4 4m4-4H3" />
								</svg>
							</a>
						</div>
					</aside>
				</div>
			</div>
		</div>
	</section>

	<section id="relatedSection" class="section hidden border-t border-line bg-page">
		<div class="container">
			<div class="mx-auto max-w-5xl">
				<h2 class="section-title">Related Articles</h2>
				<div id="relatedGrid" class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2"></div>
			</div>
		</div>
	</section>

	<template id="blogCardTemplate">
		<BlogCard href="#" title="" category="Category" />
	</template>
</Layout>

<script>
	import { fillBlogCard } from '../../scripts/blog-card';

	// Social sharing URLs (need the current URL) and related posts.
	const CMS_BASE = (import.meta.env.PUBLIC_CMS_BASE_URL || 'http://localhost:8881').replace(/\/$/, '');
	const slug = window.location.pathname.split('/').filter(Boolean).pop();
	const currentUrl = window.location.origin + window.location.pathname;

	const shareLinkedIn = document.getElementById('shareLinkedIn') as HTMLAnchorElement | null;
	const shareTwitter = document.getElementById('shareTwitter') as HTMLAnchorElement | null;
	const shareFacebook = document.getElementById('shareFacebook') as HTMLAnchorElement | null;
	const blogTitle = document.querySelector('h1')?.textContent?.trim() || '';

	if (shareLinkedIn) shareLinkedIn.href = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(currentUrl)}`;
	if (shareTwitter) shareTwitter.href = `https://twitter.com/intent/tweet?url=${encodeURIComponent(currentUrl)}&text=${encodeURIComponent(blogTitle)}`;
	if (shareFacebook) shareFacebook.href = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`;

	const relatedSection = document.getElementById('relatedSection');
	const relatedGrid = document.getElementById('relatedGrid');
	const cardTemplate = document.getElementById('blogCardTemplate') as HTMLTemplateElement | null;

	async function loadRelatedPosts() {
		if (!relatedSection || !relatedGrid || !cardTemplate || !slug) return;
		try {
			const res = await fetch(`${CMS_BASE}/wp-json/mekan/v1/blogs?per_page=4`, { headers: { Accept: 'application/json' } });
			if (!res.ok) return;
			const blogs = await res.json();
			if (!Array.isArray(blogs)) return;
			const related = blogs.filter((b) => b.slug !== slug).slice(0, 2);
			if (related.length > 0) {
				relatedGrid.replaceChildren(...related.map((b) => fillBlogCard(cardTemplate, b)));
				relatedSection.classList.remove('hidden');
			}
		} catch {
			// Related posts are optional
		}
	}

	loadRelatedPosts();
</script>
