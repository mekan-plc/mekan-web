];

const projectCards = projects.length > 0 ? projects : fallbackProjects;

// Shown when the CMS has no featured posts (or is offline).
const fallbackBlogs = [
	{
		slug: 'global-gap-certification-guide-2024',
		category: 'Certification',
		date: 'January 15, 2024',
		title: 'The Complete Guide to GlobalG.A.P. Certification for Ethiopian Exporters',
		excerpt: 'Navigate the complex world of GlobalG.A.P. certification with our comprehensive guide. Learn step-by-step how Ethiopian agricultural exporters can achieve and maintain this crucial certification for accessing European markets.',
		imageUrl: null
	},
	{
		slug: 'sustainable-farming-practices-2024',
		category: 'Sustainability',
		date: 'January 10, 2024',
		title: '5 Sustainable Farming Practices Transforming Ethiopian Agriculture',
		excerpt: 'Discover the innovative sustainable farming practices that are reshaping agriculture across Ethiopia. From water conservation to integrated pest management, learn how modern farmers are balancing productivity with environmental stewardship.',
		imageUrl: null
	},
	{
		slug: 'eu-export-compliance-2024',
		category: 'Compliance',
		date: 'January 5, 2024',
		title: 'EU Export Compliance: New Regulations Ethiopian Agribusinesses Must Know',
		excerpt: 'Stay ahead of changing EU regulations with our comprehensive overview of new compliance requirements. Understand the latest food safety standards, documentation needs, and traceability systems for Ethiopian exporters entering European markets.',
