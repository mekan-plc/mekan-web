					</div>

					<div class="mt-10">
						<p class="mb-4 text-small text-muted">Follow us on social media</p>
						<div class="flex gap-3">
							{socialLinks.map((social) => (
								<a
									href={social.href}
									target={social.external ? '_blank' : undefined}
									rel={social.external ? 'noopener noreferrer' : undefined}
									class="btn-icon h-11 w-11"
									aria-label={social.label}
								>
									<svg class="h-5 w-5" fill={social.filled ? 'currentColor' : 'none'} stroke={social.filled ? 'none' : 'currentColor'} stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
										<path d={social.icon} />
									</svg>
								</a>
							))}
						</div>
					</div>

					{/* Business hours: a tint callout (guide §6) */}
					<div class="mt-8 rounded-card bg-tint-brand p-5">
						<div class="mb-2 flex items-center gap-2">
							<svg class="h-4 w-4 text-brand" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
								<path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>
							<p class="text-small font-semibold text-heading">Business Hours</p>
						</div>
						<p class="pl-6 text-small text-muted">
							Monday - Friday: 8:00 AM - 6:00 PM<br />
							Saturday: 9:00 AM - 2:00 PM
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>

<script>
	const form = document.getElementById('contactForm') as HTMLFormElement;
	const formFields = document.getElementById('formFields');
	const formSuccess = document.getElementById('formSuccess');
	const formError = document.getElementById('formError');
	const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
	const submitLabel = document.getElementById('submitLabel');

	// Validation elements
	const nameInput = document.getElementById('name') as HTMLInputElement;
	const emailInput = document.getElementById('email') as HTMLInputElement;
	const phoneInput = document.getElementById('phone') as HTMLInputElement;
	const countryCodeSelect = document.getElementById('countryCode') as HTMLSelectElement;
	const serviceInput = document.getElementById('service') as HTMLSelectElement;
	const messageInput = document.getElementById('message') as HTMLTextAreaElement;
	
	const nameError = document.getElementById('nameError');
	const emailError = document.getElementById('emailError');
	const phoneError = document.getElementById('phoneError');
	const messageError = document.getElementById('messageError');
	const messageCount = document.getElementById('messageCount');
	const messageProgress = document.getElementById('messageProgress');

	// Country Picker
	const countryPickerBtn = document.getElementById('countryPickerBtn');
	const countryDropdown = document.getElementById('countryDropdown');
	const countryList = document.getElementById('countryList');
	const countrySearch = document.getElementById('countrySearch');
	const selectedFlag = document.getElementById('selectedFlag');
	const selectedCode = document.getElementById('selectedCode');
	const countryCodeInput = document.getElementById('countryCode') as HTMLInputElement;
	const countryBackdrop = document.getElementById('countryBackdrop');

	const countries = [
		{ code: '+251', flag: '🇪🇹', name: 'Ethiopia' },
		{ code: '+1', flag: '🇺🇸', name: 'United States' },
		{ code: '+44', flag: '🇬🇧', name: 'United Kingdom' },
		{ code: '+49', flag: '🇩🇪', name: 'Germany' },
		{ code: '+33', flag: '🇫🇷', name: 'France' },
		{ code: '+39', flag: '🇮🇹', name: 'Italy' },
		{ code: '+31', flag: '🇳🇱', name: 'Netherlands' },
		{ code: '+32', flag: '🇧🇪', name: 'Belgium' },
		{ code: '+46', flag: '🇸🇪', name: 'Sweden' },
		{ code: '+47', flag: '🇳🇴', name: 'Norway' },
		{ code: '+45', flag: '🇩🇰', name: 'Denmark' },
		{ code: '+358', flag: '🇫🇮', name: 'Finland' },
		{ code: '+41', flag: '🇨🇭', name: 'Switzerland' },
		{ code: '+43', flag: '🇦🇹', name: 'Austria' },
		{ code: '+34', flag: '🇪🇸', name: 'Spain' },
		{ code: '+351', flag: '🇵🇹', name: 'Portugal' },
		{ code: '+27', flag: '🇿🇦', name: 'South Africa' },
		{ code: '+254', flag: '🇰🇪', name: 'Kenya' },
		{ code: '+255', flag: '🇹🇿', name: 'Tanzania' },
		{ code: '+256', flag: '🇺🇬', name: 'Uganda' },
		{ code: '+250', flag: '🇷🇼', name: 'Rwanda' },
		{ code: '+253', flag: '🇩🇯', name: 'Djibouti' },
		{ code: '+252', flag: '🇸🇴', name: 'Somalia' },
		{ code: '+249', flag: '🇸🇩', name: 'Sudan' },
		{ code: '+20', flag: '🇪🇬', name: 'Egypt' },
		{ code: '+212', flag: '🇲🇦', name: 'Morocco' },
		{ code: '+216', flag: '🇹🇳', name: 'Tunisia' },
		{ code: '+213', flag: '🇩🇿', name: 'Algeria' },
		{ code: '+218', flag: '🇱🇾', name: 'Libya' },
		{ code: '+234', flag: '🇳🇬', name: 'Nigeria' },
		{ code: '+233', flag: '🇬🇭', name: 'Ghana' },
		{ code: '+225', flag: '🇨🇮', name: 'Ivory Coast' },
		{ code: '+221', flag: '🇸🇳', name: 'Senegal' },
		{ code: '+91', flag: '🇮🇳', name: 'India' },
		{ code: '+86', flag: '🇨🇳', name: 'China' },
		{ code: '+81', flag: '🇯🇵', name: 'Japan' },
		{ code: '+82', flag: '🇰🇷', name: 'South Korea' },
		{ code: '+61', flag: '🇦🇺', name: 'Australia' },
	];

	function renderCountryList(filter = '') {
		if (!countryList) return;
		const filtered = countries.filter(c =>
			c.name.toLowerCase().includes(filter.toLowerCase()) ||
			c.code.includes(filter)
		);

		if (filtered.length === 0) {
			countryList.innerHTML = `<p class="px-4 py-8 text-center text-small text-muted">No countries found</p>`;
			return;
		}

		const current = countryCodeInput?.value || '+251';
		countryList.innerHTML = filtered.map((country) => `
			<button type="button" role="option" aria-selected="${country.code === current}" class="flex w-full items-center gap-3 rounded-control px-3 py-2.5 text-left transition-colors duration-fast ease-out hover:bg-tint-brand aria-selected:bg-tint-brand" data-code="${country.code}" data-flag="${country.flag}">
				<span class="text-xl leading-none" aria-hidden="true">${country.flag}</span>
				<span class="min-w-0 flex-1">
					<span class="block truncate text-small font-medium text-ink">${country.name}</span>
					<span class="text-small text-muted">${country.code}</span>
				</span>
				${country.code === '+251' ? '<span class="badge badge-brand">Default</span>' : ''}
			</button>
		`).join('');

		countryList.querySelectorAll('button').forEach(btn => {
			btn.addEventListener('click', () => {
				const code = btn.dataset.code || '+251';
				const flag = btn.dataset.flag || '🇪🇹';
				if (selectedFlag) selectedFlag.textContent = flag;
				if (selectedCode) selectedCode.textContent = code;
				if (countryCodeInput) countryCodeInput.value = code;
				closeDropdown();
				countryPickerBtn?.focus();
			});
		});
	}

	function openDropdown() {
		renderCountryList(countrySearch?.value || '');
		if (countryBackdrop) {
			countryBackdrop.classList.remove('hidden');
			setTimeout(() => countryBackdrop?.classList.remove('opacity-0'), 10);
		}
		if (countryDropdown) {
			countryDropdown.classList.remove('hidden');
			countryPickerBtn?.setAttribute('aria-expanded', 'true');
			countrySearch?.focus();
		}
	}

	function closeDropdown() {
		if (countryBackdrop) {
			countryBackdrop.classList.add('opacity-0');
			setTimeout(() => countryBackdrop?.classList.add('hidden'), 200);
		}
		if (countryDropdown) {
			countryDropdown.classList.add('hidden');
			countryPickerBtn?.setAttribute('aria-expanded', 'false');
		}
	}

	// Initialize country list
	renderCountryList();

	// Toggle dropdown
	countryPickerBtn?.addEventListener('click', (e) => {
		e.stopPropagation();
		if (countryDropdown?.classList.contains('hidden')) {
			openDropdown();
		} else {
			closeDropdown();
		}
	});

	// Close on backdrop click
	countryBackdrop?.addEventListener('click', () => {
		closeDropdown();
	});

	// Search functionality
	countrySearch?.addEventListener('input', () => {
		renderCountryList(countrySearch.value);
	});

	// Close dropdown when clicking outside
	document.addEventListener('click', (e) => {
		const target = e.target as HTMLElement;
		if (!target.closest('#countryPicker')) {
			closeDropdown();
		}
	});

	// Close on escape key
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && !countryDropdown?.classList.contains('hidden')) {
			closeDropdown();
			countryPickerBtn?.focus();
		}
	});

	// Field error display: the message goes into the error's <span> (keeping its icon),
	// and aria-invalid drives the danger border from the .input component.
	function setFieldError(input: HTMLElement | null, errorEl: HTMLElement | null, message: string) {
		const text = errorEl?.querySelector('span');
		if (text) text.textContent = message;
		errorEl?.classList.toggle('hidden', !message);
		if (message) input?.setAttribute('aria-invalid', 'true');
		else input?.removeAttribute('aria-invalid');
	}

	// Validation functions
	function validateName(name: string): { valid: boolean; error: string } {
		if (!name || name.trim().length === 0) {
			return { valid: false, error: 'Name is required' };
		}
		if (name.length > 50) {
			return { valid: false, error: 'Name must be 50 characters or less' };
		}
		// Only letters and spaces allowed (no numbers or special characters)
		const nameRegex = /^[a-zA-Z\s]+$/;
		if (!nameRegex.test(name)) {
			return { valid: false, error: 'Name can only contain letters and spaces' };
		}
		return { valid: true, error: '' };
	}

	function validateEmail(email: string): { valid: boolean; error: string } {
		if (!email || email.trim().length === 0) {
			return { valid: false, error: 'Email is required' };
		}
		const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
		if (!emailRegex.test(email)) {
			return { valid: false, error: 'Please enter a valid email address' };
		}
		return { valid: true, error: '' };
	}

	function validatePhone(phone: string): { valid: boolean; error: string } {
		if (!phone || phone.trim().length === 0) {
			return { valid: false, error: 'Phone number is required' };
		}
		// Only digits allowed
		const phoneRegex = /^\d+$/;
		if (!phoneRegex.test(phone)) {
			return { valid: false, error: 'Phone number can only contain numbers' };
		}
		if (phone.length < 8 || phone.length > 14) {
			return { valid: false, error: 'Please enter a valid phone number' };
		}
		return { valid: true, error: '' };
	}

	function validateMessage(message: string): { valid: boolean; error: string } {
		if (!message || message.trim().length === 0) {
			return { valid: false, error: 'Message is required' };
		}
		if (message.length > 500) {
			return { valid: false, error: 'Message must be 500 characters or less' };
		}
		return { valid: true, error: '' };
	}

	// Real-time validation: only show an error once the visitor has typed something.
	const liveError = (input: HTMLInputElement | HTMLTextAreaElement, errorEl: HTMLElement | null, result: { valid: boolean; error: string }) => {
		setFieldError(input, errorEl, !result.valid && input.value.length > 0 ? result.error : '');
	};

	nameInput?.addEventListener('input', () => {
		liveError(nameInput, nameError, validateName(nameInput.value));
	});

	emailInput?.addEventListener('input', () => {
		liveError(emailInput, emailError, validateEmail(emailInput.value));
	});

	// Phone number input restriction - only allow numbers
	phoneInput?.addEventListener('input', () => {
		// Remove any non-digit characters
		phoneInput.value = phoneInput.value.replace(/\D/g, '');

		// Limit to 10 digits
		if (phoneInput.value.length > 10) {
			phoneInput.value = phoneInput.value.slice(0, 10);
		}

		liveError(phoneInput, phoneError, validatePhone(phoneInput.value));
	});

	// Message character counter
	messageInput?.addEventListener('input', () => {
		const count = messageInput.value.length;
		const percentage = (count / 500) * 100;
		const nearLimit = count > 450;

		if (messageCount) {
			messageCount.textContent = `${count} / 500`;
			messageCount.classList.toggle('text-danger', nearLimit);
			messageCount.classList.toggle('text-muted', !nearLimit);
		}

		if (messageProgress) {
			messageProgress.style.width = `${percentage}%`;
			messageProgress.classList.toggle('bg-danger', nearLimit);
			messageProgress.classList.toggle('bg-accent', !nearLimit);
		}

		liveError(messageInput, messageError, validateMessage(messageInput.value));
	});

	// WP REST API endpoint for contact form (direct to CMS)
	const API_ENDPOINT = '/api/contact';

	const fieldsByName: Record<string, [HTMLElement | null, HTMLElement | null]> = {
		name: [nameInput, nameError],
		email: [emailInput, emailError],
		phone: [phoneInput, phoneError],
		message: [messageInput, messageError]
	};

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();

		// Validate fields in order; stop at the first problem and focus it.
		const checks: [HTMLInputElement | HTMLTextAreaElement, HTMLElement | null, { valid: boolean; error: string }][] = [
			[nameInput, nameError, validateName(nameInput?.value || '')],
			[emailInput, emailError, validateEmail(emailInput?.value || '')],
			[phoneInput, phoneError, validatePhone(phoneInput?.value || '')],
			[messageInput, messageError, validateMessage(messageInput?.value || '')]
		];
		for (const [input, errorEl, result] of checks) {
			if (!result.valid) {
				setFieldError(input, errorEl, result.error);
				input?.focus();
				return;
			}
		}

		if (submitBtn) {
			submitBtn.disabled = true;
			if (submitLabel) submitLabel.textContent = 'Sending...';
		}

		// Combine country code with phone number
		const fullPhone = `${countryCodeSelect?.value || '+251'}${phoneInput?.value || ''}`;

		// Prepare JSON payload
		const payload = {
			name: nameInput?.value?.trim() || '',
			email: emailInput?.value?.trim() || '',
			phone: fullPhone,
			service: serviceInput?.value || 'General Inquiry',
			message: messageInput?.value?.trim() || ''
		};

		try {
			const response = await fetch(API_ENDPOINT, {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
				},
				body: JSON.stringify(payload),
			});

			const text = await response.text();
			let result: any = null;
			try {
				result = text ? JSON.parse(text) : null;
			} catch {
				result = null;
			}

			if (!result) {
				throw new Error('Something went wrong. Please try again.');
			}

			if (result.success) {
				formFields?.classList.add('hidden');
				formSuccess?.classList.remove('hidden');
				formError?.classList.add('hidden');
				document.getElementById('formSuccessTitle')?.focus();
			} else {
				// Handle validation errors from server
				if (result.errors) {
					Object.entries(result.errors).forEach(([field, errorMsg]) => {
						const [input, errorEl] = fieldsByName[field] || [];
						if (!errorEl) return;
						setFieldError(input ?? null, errorEl, String(errorMsg));
						input?.focus();
					});
				}
				throw new Error(result.message || 'Failed to send message');
			}
		} catch (error) {
			if (formError) {
				const text = formError.querySelector('span');
				if (text) text.textContent = error instanceof Error ? error.message : 'Something went wrong. Please try again.';
				formError.classList.remove('hidden');
			}
		} finally {
			if (submitBtn) {
				submitBtn.disabled = false;
				if (submitLabel) submitLabel.textContent = 'Send message';
			}
		}
	});

	(async function checkWordPressConnection() {
		const CMS_BASE = (import.meta.env.PUBLIC_CMS_BASE_URL || 'http://localhost:8881').replace(/\/$/, '');
		let available = false;
		try {
			const res = await fetch(`${CMS_BASE}/wp-json/mekan/v1/blogs?per_page=1`, {
				method: 'HEAD',
				headers: { Accept: 'application/json' }
			});
			available = res.ok;
		} catch {}
		try {
			if (available) localStorage.removeItem('mekan_da_fallback');
			else localStorage.setItem('mekan_da_fallback', '1');
		} catch {}
	})();
</script>
