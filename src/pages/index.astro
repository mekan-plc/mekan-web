---
import Layout from '../layouts/Layout.astro';
import BlogCard from '../components/BlogCard.astro';
import PartnersMarquee from '../components/PartnersMarquee.astro';
import PartnerWall from '../components/PartnerWall.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Testimonials from '../components/Testimonials.astro';
import { testimonials } from '../data/testimonials';
import { listFeaturedProjects, listBlogs } from '../lib/wp';

const { blogs: featuredBlogs } = await listBlogs({ perPage: 3, featured: true }).catch(() => ({ blogs: [] }));

const { projects } = await listFeaturedProjects({ perPage: 3 }).catch(() => ({ projects: [] }));

// Shown when the CMS has no featured projects (or is offline).
const fallbackProjects = [
	{
		slug: 'globalgap-certification-for-sidama-coffee-cooperative',
		client: 'Sidama Coffee Farmers Cooperative Union',
		title: 'GLOBALG.A.P Certification for Sidama Coffee Cooperative',
		description: 'Implemented comprehensive GLOBALG.A.P certification program for 2,400 smallholder coffee farmers, enabling access to premium European markets.',
		imageUrl: null
	},
	{
		slug: 'sesame-export-quality-improvement-program',
		client: 'Ethiopian Sesame Exporters Association',
		title: 'Sesame Export Quality Improvement Program',
		description: 'Established quality control systems and export documentation processes for major sesame exporters targeting Middle Eastern and Asian markets.',
		imageUrl: null
	},
	{
