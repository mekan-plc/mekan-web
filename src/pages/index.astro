	}
];

function formatDate(dateStr: string) {
	return new Date(dateStr).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

function stripHtml(html: string) {
	return html.replace(/<[^>]*>/g, '').substring(0, 120) + '...';
}
---

<Layout title="Mekan PLC | Quality Management, Compliance & Training" description="Mekan PLC provides quality management consulting, compliance support, certification readiness, and training services for agribusiness and related sectors in Ethiopia." overlayNav>
	<!-- Hero: navy brand band, project photos on the right from lg (guide §10, §14) -->
	{/* One screen tall; on very tall desktop monitors capped at 60rem so the content does not float in empty navy. */}
	<section id="home" class="brand-band relative isolate flex min-h-[100svh] flex-col overflow-hidden lg:min-h-[min(100vh,60rem)]">
		{/* Photos fade in turn. Navy scrims keep the nav, the headline edge and the partner strip on calm, dark areas (guide §10). */}
		<div class="absolute inset-y-0 right-0 -z-10 hidden w-[54%] lg:block" aria-hidden="true">
			{/* The mask fades the photos into the navy band, so there is no seam at the panel edge. */}
			<div class="absolute inset-0 [mask-image:linear-gradient(to_right,transparent,black_55%)]">
				{[1, 2, 3, 4, 5].map((num, index) => (
					<div
						class="hero-slide absolute inset-0 bg-cover bg-center bg-no-repeat"
						style={`background-image: url('/hero/${num}.jpg'); opacity: ${index === 0 ? '1' : '0'}; animation-delay: ${index * 6}s;`}
					/>
				))}
			</div>
			<div class="absolute inset-x-0 top-0 h-36 bg-gradient-to-b from-brand-surface/85 to-transparent"></div>
			<div class="absolute inset-x-0 bottom-0 h-56 bg-gradient-to-t from-brand-surface via-brand-surface/70 to-transparent"></div>
		</div>

		{/* Height-aware spacing: on short screens (a 1366×768 laptop shows ~630px) the space above and below
		    the content shrinks, so the headline, buttons and partner strip share the first screen. Never less
		    than the navbar needs; on tall screens the original 7rem / 8rem tops are kept. */}
		<div class="container relative flex flex-1 items-center pb-[clamp(1.5rem,4vh,2.5rem)] pt-[clamp(5.5rem,13vh,7rem)] lg:pb-[clamp(1.5rem,5vh,4rem)] lg:pt-[clamp(6rem,15vh,8rem)]">
			<div class="max-w-xl lg:max-w-[36rem]">
				<h1 class="text-hero hero-title font-medium">
					Empowering Sustainable Growth in Agribusiness
					<span class="block text-on-brand-accent">& the Supply Chain</span>
				</h1>

				<p class="lead mt-5 max-w-lg">
					Comprehensive Consulting, Compliance, and Strategic Solutions for a Resilient Future.
				</p>

				<div class="mt-8 flex flex-col gap-3 sm:flex-row">
					<a href="#contact" class="btn btn-primary h-12 px-7">
						<span>Get started</span>
						<svg class="h-[18px] w-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M17 8l4 4m0 0l-4 4m4-4H3" />
						</svg>
					</a>
					<a href="#services" class="btn btn-secondary h-12 px-7">
						<span>Our services</span>
						<svg class="h-[18px] w-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M19 9l-7 7-7-7" />
						</svg>
					</a>
				</div>
			</div>
		</div>

		<div class="relative pb-8 lg:pb-11">
			<p class="eyebrow mb-4 text-center">Who we work with</p>
			<PartnersMarquee />
		</div>

		<style>
			.hero-slide {
				animation: heroFade 30s infinite;
			}

			@keyframes heroFade {
				0%, 16% { opacity: 1; }
				20%, 96% { opacity: 0; }
				100% { opacity: 1; }
			}

			/* The hero headline also scales with the screen height, so it never pushes the partner
			 * strip below the fold on short screens. On tall screens the type scale wins (guide §7). */
			.hero-title {
				font-size: min(var(--mk-text-hero), 9vh);
			}

			/* Reduced motion (guide §9): hold the first photo instead of cycling. */
			@media (prefers-reduced-motion: reduce) {
				.hero-slide { animation: none; }
			}
		</style>
	</section>

	<!-- About: Same background, with top border -->
	<section id="about" class="section bg-page">
		<div class="container">
			<div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
				<div class="lg:col-span-7">
					<p class="eyebrow">About Us</p>
					<h2 class="section-title mt-4">Your Technical Partner for World-Class Agribusiness</h2>
					<div class="mt-6 max-w-prose space-y-4 text-copy">
						<p>
							Based in Addis Ababa, Mekan Quality Management &amp; Training PLC is a leading consultancy committed to connecting Ethiopian agribusinesses with global markets. The firm focuses on strengthening agricultural value chains through technical expertise, regulatory insight, and forward-looking strategy.
						</p>
						<p>
							As an integrated technical partner, Mekan supports enterprises in meeting complex international requirements—ranging from EU market access and Global G.A.P. certification to ESG (Environmental, Social, and Governance) standards. By combining agronomic expertise with data-driven business strategy, the company enables clients to enhance value chain performance and achieve long-term, sustainable growth.
						</p>
					</div>
					<a href="/about" class="btn btn-secondary mt-8">
						Explore more about us
						<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M17 8l4 4m0 0l-4 4m4-4H3" />
						</svg>
					</a>
				</div>

				<!-- Key numbers: Source Serif 4 in brand colour (guide §7), split by thin rules.
				     The offset frame (guide §8) sits behind the card, like the two frames of the logo. -->
				<div class="frame-offset mr-3 mb-3 lg:col-span-5">
					<dl class="card divide-y divide-line px-8 py-2">
						{[
							{ value: '8+', label: 'Years of excellence (established 2018 GC)' },
							{ value: '50+', label: 'Clients served across agribusiness and supply chains' },
							{ value: '20+', label: 'Expert freelance consultants and trainers' }
						].map((stat) => (
							<div class="grid grid-cols-[5.5rem_1fr] items-center gap-4 py-6 sm:grid-cols-[6.5rem_1fr]">
								<dt class="order-2 text-small text-muted">{stat.label}</dt>
								<dd class="order-1 font-heading text-stat font-semibold text-brand">{stat.value}</dd>
							</div>
						))}
					</dl>
				</div>
			</div>
		</div>
	</section>

	<!-- Services: Same background, with top border -->
	<section id="services" class="section border-t border-line bg-page">
		<div class="container">
			<div class="mx-auto max-w-2xl text-center">
				<p class="eyebrow">Our Services</p>
				<h2 class="section-title mt-4">Holistic Support at Every Stage of the Journey</h2>
				<p class="lead mt-4">
					From initial compliance assessments to full-scale certification support, we provide end-to-end services tailored to your needs.
				</p>
			</div>

			<div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
				{services.map((service) => (
					<a href={`/services/${service.id}`} class="card card-interactive group flex flex-col p-7 md:p-8">
						{/* Line icon on a navy tile (guide §9: one brand colour, 1.75px stroke) */}
						<span class="flex h-12 w-12 items-center justify-center rounded-control bg-brand-surface text-on-brand" aria-hidden="true">
							<svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
								{serviceIcons[service.icon].map((d) => <path d={d} />)}
							</svg>
						</span>

						<h3 class="mt-6 text-h3 text-heading transition-colors duration-fast ease-out group-hover:text-brand">
							{service.title}
						</h3>

						<p class="mt-3 flex-grow text-small text-muted">
							{service.summary}
						</p>

						<span class="mt-6 inline-flex items-center gap-2 text-button font-semibold text-accent underline-offset-4 group-hover:underline">
							Read more
							<svg class="h-4 w-4 transition-transform duration-fast ease-out group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M17 8l4 4m0 0l-4 4m4-4H3" />
							</svg>
						</span>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- Projects: Same background, with top border -->
	<section id="projects" class="section border-t border-line bg-page">
		<div class="container">
			<div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
				<div>
					<p class="eyebrow">Featured Work</p>
					<h2 class="section-title mt-4">Projects That Drive Impact</h2>
				</div>
				<a href="/projects" class="btn btn-secondary">View all projects</a>
			</div>

			<div id="projectsGrid" class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
				{projectCards.map((project, index) => (
					<ProjectCard
						href={`/projects/${project.slug}`}
						title={project.title}
						client={project.client}
						description={project.description}
						imageUrl={project.imageUrl}
						class={index >= 2 ? 'md:hidden lg:flex' : undefined}
					/>
				))}
			</div>
		</div>
	</section>

	<!-- Partners: the organisations behind the work, as a logo wall on the navy tint -->
	<PartnerWall />

	<!-- Testimonials: Same background, with top border -->
	<Testimonials items={testimonials} />

	<!-- Blog: Same background, with top border -->
	<section id="blog" class="section border-t border-line bg-page">
		<div class="container">
			<div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
				<div>
					<p class="eyebrow">Insights</p>
					<h2 class="section-title mt-4">Latest Thinking</h2>
				</div>
				<a href="/blog" class="btn btn-secondary">View all blogs</a>
			</div>

			<div id="blogGrid" class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
				{blogCards.map((blog, index) => (
					<BlogCard
						href={`/blog/${blog.slug}`}
						title={blog.title}
						date={blog.date}
						excerpt={blog.excerpt}
						category={blog.category}
						imageUrl={blog.imageUrl}
						class={index >= 2 ? 'md:hidden lg:flex' : undefined}
					/>
				))}
			</div>
		</div>
	</section>

	<!-- Contact: Two-column professional layout -->
	<section id="contact" class="section border-t border-line bg-page">
		<div class="container">
			<div class="grid items-start gap-12 lg:grid-cols-2 lg:gap-16">

				{/* Left column: contact form */}
				<div class="order-1" data-reveal>
					<div class="card p-6 md:p-10">
						<h3 class="text-h3 text-heading">Send us a message</h3>
						<p class="mb-8 mt-2 text-small text-muted">We'll respond within 24 hours with a clear path forward.</p>

						<form id="contactForm" novalidate>
							<div id="formSuccess" class="hidden py-12 text-center" role="status">
								<span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-tint-accent text-accent ring-1 ring-accent/30" aria-hidden="true">
									<svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M5 13l4 4L19 7" />
									</svg>
								</span>
								<h4 id="formSuccessTitle" class="mt-6 font-heading text-h3 font-semibold text-heading" tabindex="-1">Message Sent!</h4>
								<p class="mt-2 text-muted">We'll be in touch within 24 hours.</p>
							</div>

							<div id="formFields" class="space-y-6">
								<div class="grid gap-5 md:grid-cols-2">
									<div>
